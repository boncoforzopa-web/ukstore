{%- assign p = section.settings.product -%}
<section class="tw-section tw-drop">
  <div class="tw-wrap">
    <div class="tw-drop__card tw-glass" data-reveal{% if p != blank %} data-dd="{{ p.handle }}"{% endif %}>
      <div class="tw-drop__beam" aria-hidden="true"></div>
      <div class="tw-drop__media"{% if settings.enable_tilt %} data-tilt{% endif %}>
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 990px) 45vw, 100vw', alt: section.settings.heading }}
        {%- elsif p != blank and p.featured_image -%}
          {{ p.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 990px) 45vw, 100vw', alt: p.title }}
        {%- else -%}
          {% render 'tw-art', type: section.settings.art, hue: section.settings.hue, label: section.settings.art_label, sub: 'Drop der Woche', uid: section.id %}
        {%- endif -%}
      </div>
      <div class="tw-drop__copy">
        <p class="tw-pill">{% render 'tw-icon', name: 'spark', size: 14 %} {{ section.settings.kicker }}</p>
        <h2 class="tw-h2">{% if p != blank and section.settings.use_product_title %}{% render 'tw-lang', product: p, part: 'title' %}{% else %}{{ section.settings.heading }}{% endif %}</h2>
        <p class="tw-muted">{{ section.settings.text }}</p>
        {%- if p != blank -%}
          {% render 'tw-price', product: p, show_tax: true %}
        {%- endif -%}
        {%- liquid
          assign cd_src = blank
          if p != blank and p.metafields.custom.release_date.value != blank
            assign cd_src = p.metafields.custom.release_date.value
          elsif section.settings.end != blank
            assign cd_src = section.settings.end
          endif
          assign cd_left = 0
          if cd_src != blank
            assign cd_ts = cd_src | date: '%s' | plus: 0
            assign now_ts = 'now' | date: '%s' | plus: 0
            assign cd_left = cd_ts | minus: now_ts
          endif
        -%}
        {%- if cd_left > 0 -%}
          {%- liquid
            assign cd_d = cd_left | divided_by: 86400
            assign cd_h = cd_left | modulo: 86400 | divided_by: 3600
            assign cd_m = cd_left | modulo: 3600 | divided_by: 60
          -%}
          <div data-countdown-wrap>
            <p class="tw-kicker" style="margin-top: 1.5rem">{{ section.settings.countdown_label }}</p>
            <div class="tw-countdown" data-countdown data-countdown-ts="{{ cd_ts | times: 1000 }}" aria-label="{{ section.settings.countdown_label | escape }}">
              <span><b data-d>{{ cd_d }}</b><small>Tage</small></span>
              <span><b data-h>{% if cd_h < 10 %}0{% endif %}{{ cd_h }}</b><small>Stunden</small></span>
              <span><b data-m>{% if cd_m < 10 %}0{% endif %}{{ cd_m }}</b><small>Minuten</small></span>
            </div>
          </div>
        {%- endif -%}
        <div class="tw-drop__ctas">
          {%- if p != blank and p.available and p.has_only_default_variant -%}
            <button type="button" class="tw-btn tw-btn--gold tw-btn--lg tw-btn--shimmer" data-quick-add="{{ p.selected_or_first_available_variant.id }}">{{ section.settings.cta_label }} {% render 'tw-icon', name: 'arrow-right', size: 18 %}</button>
            <a href="{{ p.url }}" class="tw-btn tw-btn--glass tw-btn--lg">Details</a>
          {%- else -%}
            <a href="{% if p != blank %}{{ p.url }}{% else %}{{ section.settings.link }}{% endif %}" class="tw-btn tw-btn--gold tw-btn--lg tw-btn--shimmer">{{ section.settings.cta_label }} {% render 'tw-icon', name: 'arrow-right', size: 18 %}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Drop der Woche",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt" },
    { "type": "checkbox", "id": "use_product_title", "label": "Produkttitel als Überschrift", "default": true },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Drop der Woche" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Mega Evolution Elite Trainer Box" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Unser Highlight der Woche – limitiertes Kontingent, versiegelt ab Werk und innerhalb von 3–5 Werktagen bei dir." },
    { "type": "text", "id": "end", "label": "Countdown bis (YYYY-MM-DDTHH:MM)", "default": "2026-11-01T18:00", "info": "Nur genutzt, wenn das Produkt kein Release-Datum (custom.release_date) hat. Deutsche Zeit, z. B. 2026-11-01T18:00" },
    { "type": "text", "id": "countdown_label", "label": "Countdown-Label", "default": "Angebot endet in" },
    { "type": "text", "id": "done_text", "label": "Text nach Ablauf", "default": "Drop beendet – neuer Drop folgt bald" },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Jetzt sichern" },
    { "type": "url", "id": "link", "label": "Link (ohne Produkt)", "default": "/collections/all" },
    { "type": "image_picker", "id": "image", "label": "Bild (optional)" },
    { "type": "select", "id": "art", "label": "Platzhalter-Grafik", "default": "etb", "options": [ { "value": "booster", "label": "Display" }, { "value": "etb", "label": "ETB" }, { "value": "tin", "label": "Tin" }, { "value": "pack", "label": "Booster-Pack" } ] },
    { "type": "text", "id": "art_label", "label": "Platzhalter-Beschriftung", "default": "Elite Trainer" },
    { "type": "range", "id": "hue", "label": "Farbton Platzhalter", "min": 0, "max": 360, "step": 5, "default": 200 }
  ],
  "presets": [{ "name": "Drop der Woche" }]
}
{% endschema %}
