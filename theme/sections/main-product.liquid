{%- liquid
  assign current = product.selected_or_first_available_variant
  assign is_pre = false
  if product.tags contains 'Pre-order'
    assign is_pre = true
  endif
  assign low = false
  if settings.low_stock_threshold > 0 and current.inventory_management == 'shopify' and current.inventory_quantity > 0 and current.inventory_quantity <= settings.low_stock_threshold
    assign low = true
  endif
  if is_pre
    assign atc_label = 'Pre-order'
  else
    assign atc_label = 'Add to basket'
  endif
  assign crumb = collection | default: product.collections.first
-%}

<section class="tw-pdp" data-product data-section="{{ section.id }}">
  <div class="tw-wrap">
    <nav class="tw-crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>
      {%- if crumb -%}
        {%- if crumb.parent -%}<a href="{{ crumb.parent.url }}">{{ crumb.parent.title }}</a><span aria-hidden="true">/</span>{%- endif -%}
        <a href="{{ crumb.url }}">{{ crumb.title }}</a><span aria-hidden="true">/</span>
      {%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="tw-pdp__grid">
      <div class="tw-gallery" data-gallery>
        <div class="tw-gallery__main">
          <ul class="tw-gallery__track" data-gallery-track role="list">
            {%- if product.media.size > 0 -%}
              {%- for media in product.media -%}
                <li class="tw-gallery__slide" data-media-id="{{ media.id }}">
                  {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
                  <button type="button" class="tw-gallery__zoom" data-zoom="{{ media | image_url: width: 2400 }}" aria-label="Enlarge image {{ forloop.index }} of {{ product.media.size }}">
                    <span class="tw-skeleton tw-gallery__frame">
                      {{ media | image_url: width: 1400 | image_tag: loading: ld, widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 55vw, 100vw', alt: media.alt | default: product.title }}
                    </span>
                  </button>
                </li>
              {%- endfor -%}
            {%- else -%}
              <li class="tw-gallery__slide"><div class="tw-gallery__frame tw-gallery__frame--art">{% render 'tw-art', type: crumb.art %}</div></li>
            {%- endif -%}
          </ul>
          <div class="tw-gallery__badges">
            {%- if current.compare_at_price > current.price -%}<span class="tw-chip tw-chip--alert">Sale</span>{%- endif -%}
            {%- if is_pre -%}<span class="tw-chip tw-chip--gold">Pre-order</span>{%- endif -%}
          </div>
        </div>
        {%- if product.media.size > 1 -%}
          <ul class="tw-gallery__thumbs" role="list">
            {%- for media in product.media -%}
              <li>
                <button type="button" class="tw-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}>
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="tw-pdp__info">
        <div class="tw-pdp__sticky">
          {%- if product.vendor != blank and product.vendor != settings.brand_name -%}<p class="tw-pdp__brand">{{ product.vendor }}</p>{%- endif -%}
          <h1 class="tw-pdp__title">{{ product.title }}</h1>

          <div class="tw-pdp__price" data-pdp-price>
            {% render 'tw-price', product: product, variant: current, show_tax: true %}
          </div>

          {%- if product.summary != blank -%}<p class="tw-pdp__summary">{{ product.summary }}</p>{%- endif -%}

          <p class="tw-stock{% if is_pre %} tw-stock--pre{% elsif current.available == false %} tw-stock--out{% elsif low %} tw-stock--low{% endif %}" data-pdp-stock>
            <span class="tw-stock__dot" aria-hidden="true"></span>
            {%- if is_pre -%}
              Pre-order{% if product.release_date %}. Expected {{ product.release_date | date: '%-d %B %Y' }}{% endif %}
            {%- elsif current.available == false -%}
              Out of stock
            {%- elsif low -%}
              Only {{ current.inventory_quantity }} left
            {%- else -%}
              In stock{% if settings.delivery_note != blank %}. {{ settings.delivery_note }}{% endif %}
            {%- endif -%}
          </p>
          {%- if is_pre -%}
            <p class="tw-note">This item is sent when it arrives with us. Expected dates are estimates and can change; we email you if they do. Payment is taken when you order.{% if settings.preorder_page != blank %} <a href="{{ settings.preorder_page.url }}">How pre-orders work</a>{% endif %}</p>
          {%- endif -%}

          {%- form 'product', product, id: 'tw-product-form', class: 'tw-pdp__form', data-product-form: '', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ current.id }}" data-variant-input>

            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <fieldset class="tw-opt">
                  <legend>{{ option.name }}: <span data-opt-label="{{ forloop.index0 }}">{{ option.selected_value }}</span></legend>
                  <div class="tw-opt__values">
                    {%- assign oi = forloop.index0 -%}
                    {%- for value in option.values -%}
                      <label class="tw-opt__pill">
                        <input type="radio" name="tw-opt-{{ oi }}" value="{{ value | escape }}" data-option-index="{{ oi }}"{% if option.selected_value == value %} checked{% endif %}>
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
              <script type="application/json" data-variants>{{ product.variants | json }}</script>
            {%- endunless -%}

            <div class="tw-pdp__buy">
              <div class="tw-qty tw-qty--lg" data-qty>
                <button type="button" data-qty-minus aria-label="Decrease quantity">{% render 'tw-icon', name: 'minus', size: 18 %}</button>
                {%- liquid
                  assign q_max = 99
                  if current.inventory_management == 'shopify' and current.inventory_policy == 'deny' and current.inventory_quantity < 99
                    assign q_max = current.inventory_quantity | at_least: 1
                  endif
                -%}
                <input type="number" name="quantity" value="1" min="1" max="{{ q_max }}" inputmode="numeric" aria-label="Quantity">
                <button type="button" data-qty-plus aria-label="Increase quantity">{% render 'tw-icon', name: 'plus', size: 18 %}</button>
              </div>
              <button type="submit" name="add" class="tw-btn tw-btn--gold tw-btn--lg tw-pdp__atc" data-atc data-label="{{ atc_label }}"{% unless current.available %} disabled{% endunless %}>
                <span data-atc-text>{% if current.available %}{{ atc_label }}{% else %}Out of stock{% endif %}</span>
              </button>
              {%- if settings.enable_wishlist -%}
                <button type="button" class="tw-wish tw-wish--inline" data-wishlist="{{ product.handle }}" aria-pressed="false" aria-label="Save {{ product.title | escape }}">{% render 'tw-icon', name: 'heart', size: 20 %}</button>
              {%- endif -%}
            </div>
            <div class="tw-pdp__errors tw-error" role="alert" data-form-error hidden></div>
          {%- endform -%}
          {%- if current.available == false and is_pre == false -%}{% render 'tw-back-in-stock', variant: current, product: product %}{%- endif -%}

          <div class="tw-accordion tw-pdp__details">
            <details class="tw-acc" open>
              <summary class="tw-acc__q"><span>Description</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary>
              <div class="tw-acc__a"><div class="tw-rte">{{ product.description }}</div></div>
            </details>
            {%- if product.specs.size > 0 or current.sku != blank -%}
              <details class="tw-acc">
                <summary class="tw-acc__q"><span>Specifications</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary>
                <div class="tw-acc__a">
                  <dl class="tw-specs">
                    {%- for spec in product.specs -%}<div><dt>{{ spec.name }}</dt><dd>{{ spec.value }}</dd></div>{%- endfor -%}
                    {%- if current.sku != blank -%}<div><dt>Product code</dt><dd>{{ current.sku }}</dd></div>{%- endif -%}
                  </dl>
                </div>
              </details>
            {%- endif -%}
            {%- assign extra = product.metafields.details -%}
            {%- if extra.included != blank -%}
              <details class="tw-acc"><summary class="tw-acc__q"><span>What’s included</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary><div class="tw-acc__a"><div class="tw-rte">{{ extra.included }}</div></div></details>
            {%- endif -%}
            {%- if extra.care != blank -%}
              <details class="tw-acc"><summary class="tw-acc__q"><span>Assembly and care</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary><div class="tw-acc__a"><div class="tw-rte">{{ extra.care }}</div></div></details>
            {%- endif -%}
            {%- if extra.warranty != blank -%}
              <details class="tw-acc"><summary class="tw-acc__q"><span>Warranty</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary><div class="tw-acc__a"><div class="tw-rte">{{ extra.warranty }}</div></div></details>
            {%- endif -%}
            <details class="tw-acc">
              <summary class="tw-acc__q"><span>Delivery and returns</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary>
              <div class="tw-acc__a"><div class="tw-rte">
                <p>We deliver to UK addresses. Delivery options and prices are shown at checkout before you pay.{% if settings.shipping_page != blank %} <a href="{{ settings.shipping_page.url }}">Delivery details</a>{% endif %}</p>
                <p>You can cancel for any reason up to 14 days after your order arrives.{% if settings.returns_page != blank %} <a href="{{ settings.returns_page.url }}">Returns and refunds</a>{% endif %}</p>
              </div></div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tw-stickyatc" data-sticky-atc aria-hidden="true">
    <div class="tw-stickyatc__info">
      <p class="tw-stickyatc__title">{{ product.title }}</p>
      <p class="tw-stickyatc__price" data-sticky-price>{{ current.price | money }}</p>
    </div>
    <button type="button" class="tw-btn tw-btn--gold" data-sticky-trigger tabindex="-1"{% unless current.available %} disabled{% endunless %}>
      <span>{% if current.available %}{{ atc_label }}{% else %}Out of stock{% endif %}</span>
    </button>
  </div>

  <dialog class="tw-lightbox" data-lightbox aria-label="Enlarged image">
    <button type="button" class="tw-iconbtn tw-iconbtn--glass tw-lightbox__close" data-close aria-label="Close">{% render 'tw-icon', name: 'close', size: 22 %}</button>
    <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" width="1600" height="1600" alt="{{ product.title | escape }}" data-lightbox-img>
  </dialog>
</section>

{% schema %}
{ "name": "Product page", "settings": [] }
{% endschema %}
