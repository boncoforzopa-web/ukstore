{%- assign menu = linklists[section.settings.menu] -%}
<header class="tw-header" data-header>
  <div class="tw-wrap tw-header__bar">
    <div class="tw-header__side">
      <button type="button" class="tw-iconbtn tw-header__burger" data-open="tw-menu" aria-controls="tw-menu" aria-expanded="false" aria-label="Open menu">
        {% render 'tw-icon', name: 'menu', size: 22 %}
      </button>
      <button type="button" class="tw-header__search" data-open="tw-search-overlay" aria-label="Search">
        {% render 'tw-icon', name: 'search', size: 20 %}<span>Search</span>
      </button>
    </div>

    {% render 'tw-logo', uid: 'h' %}

    <div class="tw-header__side tw-header__side--end">
      <a href="/pages/contact" class="tw-header__text">Help</a>
      {%- if settings.enable_wishlist -%}
        <a href="/pages/wishlist" class="tw-iconbtn tw-header__wish" aria-label="Saved items" data-wishlist-link>
          {% render 'tw-icon', name: 'heart', size: 21 %}
          <span class="tw-cartbtn__count is-empty" data-wishlist-count aria-hidden="true">0</span>
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="tw-iconbtn tw-cartbtn" data-open="tw-cart" aria-controls="tw-cart" aria-label="Basket, {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}">
        {% render 'tw-icon', name: 'bag', size: 21 %}
        <span class="tw-cartbtn__count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count aria-hidden="true">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if menu.links.size > 0 -%}
    <nav class="tw-nav" aria-label="Main">
      <ul class="tw-wrap tw-nav__list" role="list">
        {%- for link in menu.links -%}
          {%- assign lcol = link.object -%}
          <li class="tw-nav__item{% if link.links.size > 0 %} has-mega{% endif %}"{% if link.links.size > 0 %} data-mega{% endif %}>
            {%- if link.links.size > 0 -%}
              <a href="{{ link.url }}" class="tw-nav__link{% if link.child_active or link.active %} is-active{% endif %}" aria-haspopup="true" aria-expanded="false">{{ link.title }}</a>
              <div class="tw-mega" data-mega-panel>
                <div class="tw-wrap tw-mega__inner">
                  <div class="tw-mega__col">
                    <p class="tw-mega__title">{{ lcol.title | default: link.title }}</p>
                    <ul role="list" class="tw-mega__links">
                      {%- for child in link.links -%}
                        <li><a href="{{ child.url }}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                    <a href="{{ link.url }}" class="tw-link">Shop all {{ lcol.title | default: link.title | downcase }}</a>
                  </div>
                  <a href="{{ link.url }}" class="tw-mega__promo" tabindex="-1" aria-hidden="true">
                    <span class="tw-arch">
                      {%- if lcol.image -%}{{ lcol.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'tw-art', type: lcol.art %}{%- endif -%}
                    </span>
                  </a>
                </div>
              </div>
            {%- else -%}
              <a href="{{ link.url }}" class="tw-nav__link{% if link.active %} is-active{% endif %}{% if link.url contains '/sale' %} tw-nav__link--sale{% endif %}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</header>

<dialog class="tw-drawer tw-drawer--left" id="tw-menu" aria-label="Menu">
  <div class="tw-drawer__panel">
    <div class="tw-drawer__head">
      <p class="tw-drawer__title">Menu</p>
      <button type="button" class="tw-iconbtn" data-close aria-label="Close menu">{% render 'tw-icon', name: 'close', size: 22 %}</button>
    </div>
    <div class="tw-drawer__body">
      <ul class="tw-mnav" role="list">
        {%- for link in menu.links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details class="tw-mnav__group">
                <summary>{{ link.object.title | default: link.title }}{% render 'tw-icon', name: 'chevron-down', size: 18 %}</summary>
                <ul role="list">
                  <li><a href="{{ link.url }}" class="tw-mnav__all">Shop all</a></li>
                  {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}"{% if link.url contains '/sale' %} class="tw-nav__link--sale"{% endif %}>{{ link.object.title | default: link.title }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
    <div class="tw-drawer__foot">
      <ul class="tw-mnav__service" role="list">
        <li><a href="/pages/contact">Contact us</a></li>
        <li><a href="/pages/delivery">Delivery</a></li>
        <li><a href="/pages/returns">Returns</a></li>
        <li><a href="/pages/order-tracking">Track an order</a></li>
      </ul>
    </div>
  </div>
</dialog>

{% schema %}
{
  "name": "Header",
  "class": "tw-header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main" }
  ]
}
{% endschema %}
