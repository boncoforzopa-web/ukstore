<footer class="tw-footer">
  <div class="tw-wrap">
    <div class="tw-footer__top">
      <div class="tw-footer__brand">
        {% render 'tw-logo', uid: 'f' %}
        <p class="tw-footer__about">{{ section.settings.about }}</p>
        {%- if settings.contact_email != blank or settings.contact_phone != blank or settings.opening_hours != blank or settings.business_address != blank -%}
          <ul class="tw-footer__contact" role="list">
            {%- if settings.contact_email != blank -%}<li>{% render 'tw-icon', name: 'mail', size: 16 %}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>{%- endif -%}
            {%- if settings.contact_phone != blank -%}<li>{% render 'tw-icon', name: 'phone', size: 16 %}<a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a></li>{%- endif -%}
            {%- if settings.opening_hours != blank -%}<li>{% render 'tw-icon', name: 'clock', size: 16 %}<span>{{ settings.opening_hours }}</span></li>{%- endif -%}
            {%- if settings.business_address != blank -%}<li>{% render 'tw-icon', name: 'pin', size: 16 %}<span>{{ settings.business_address | newline_to_br }}</span></li>{%- endif -%}
          </ul>
        {%- endif -%}
        {%- if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_pinterest != blank or settings.social_tiktok != blank -%}
          <ul class="tw-social" role="list">
            {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'tw-icon', name: 'instagram', size: 20 %}</a></li>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'tw-icon', name: 'facebook', size: 20 %}</a></li>{%- endif -%}
            {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest">{% render 'tw-icon', name: 'pinterest', size: 20 %}</a></li>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'tw-icon', name: 'tiktok', size: 20 %}</a></li>{%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      {%- assign cols = 'menu_shop,menu_help,menu_about' | split: ',' -%}
      {%- for col in cols -%}
        {%- assign m = linklists[section.settings[col]] -%}
        <nav class="tw-footer__col" aria-label="{{ m.title | escape }}">
          <p class="tw-footer__title">{{ m.title }}</p>
          <ul role="list">
            {%- for link in m.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
            {%- if col == 'menu_about' and settings.cookie_banner -%}<li><button type="button" class="tw-footer__btn" data-cookie-open>Cookie settings</button></li>{%- endif -%}
          </ul>
        </nav>
      {%- endfor -%}
    </div>

    <div class="tw-footer__bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ settings.legal_name | default: settings.brand_name }}{% if settings.company_number != blank %}. Company no. {{ settings.company_number }}{% endif %}{% if settings.vat_number != blank %}. VAT no. {{ settings.vat_number }}{% endif %}. Prices in pounds sterling (GBP).</p>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="tw-payicons" role="list" aria-label="Payment methods">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag: class: 'tw-payicon' }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "menu_shop", "label": "Shop menu", "default": "footer-shop" },
    { "type": "link_list", "id": "menu_help", "label": "Customer service menu", "default": "footer-help" },
    { "type": "link_list", "id": "menu_about", "label": "About menu", "default": "footer-about" },
    { "type": "textarea", "id": "about", "label": "About text" }
  ]
}
{% endschema %}
