{%- liquid
  assign visible = 0
  for block in section.blocks
    if block.settings.sample == false or request.design_mode
      assign visible = visible | plus: 1
    endif
  endfor
-%}
{%- if visible > 0 -%}
<section class="tw-section tw-reviews">
  <div class="tw-wrap">
    <div class="tw-head" data-reveal>
      <div>
        {%- if section.settings.kicker != blank -%}<p class="tw-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="tw-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.source_note != blank -%}<p class="tw-muted tw-small tw-head__text">{{ section.settings.source_note }}</p>{%- endif -%}
      </div>
      <div class="tw-carousel__nav">
        <button type="button" class="tw-iconbtn tw-iconbtn--glass" data-carousel-prev aria-label="Vorherige Bewertung">{% render 'tw-icon', name: 'arrow-left', size: 18 %}</button>
        <button type="button" class="tw-iconbtn tw-iconbtn--glass" data-carousel-next aria-label="Nächste Bewertung">{% render 'tw-icon', name: 'arrow-right', size: 18 %}</button>
      </div>
    </div>
    <div class="tw-carousel" data-carousel data-autoplay="{{ section.settings.autoplay }}" role="region" aria-roledescription="Karussell" aria-label="Kundenbewertungen">
      <ul class="tw-carousel__track" role="list" data-carousel-track tabindex="0">
        {%- for block in section.blocks -%}
          {%- if block.settings.sample == false or request.design_mode -%}
            <li class="tw-review tw-glass" aria-roledescription="Folie" aria-label="{{ forloop.index }} von {{ visible }}" {{ block.shopify_attributes }}>
              {%- if block.settings.sample -%}<p class="tw-review__sample">Beispiel – nur im Editor sichtbar. Durch echte Bewertung ersetzen und „Beispiel“ deaktivieren.</p>{%- endif -%}
              <div class="tw-stars" role="img" aria-label="{{ block.settings.rating }} von 5 Sternen">
                {%- for i in (1..5) -%}<span class="{% if i > block.settings.rating %}is-off{% endif %}">{% render 'tw-icon', name: 'star', size: 18 %}</span>{%- endfor -%}
              </div>
              <blockquote class="tw-review__text">„{{ block.settings.text }}“</blockquote>
              <div class="tw-review__meta">
                <span class="tw-review__avatar" aria-hidden="true">{{ block.settings.name | slice: 0 }}</span>
                <div>
                  <p class="tw-review__name">{{ block.settings.name }}{% if block.settings.verified %} <span class="tw-review__verified">{% render 'tw-icon', name: 'check', size: 13 %} Verifizierter Kauf</span>{% endif %}</p>
                  <p class="tw-muted tw-small">{{ block.settings.product }}{% if block.settings.date != blank %} · {{ block.settings.date }}{% endif %}</p>
                </div>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <div class="tw-carousel__dots" data-carousel-dots aria-hidden="true"></div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Bewertungen",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Stimmen unserer Sammler" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Was Kunden über uns sagen" },
    { "type": "text", "id": "source_note", "label": "Hinweis zur Herkunft der Bewertungen", "default": "Bewertungen stammen von Kunden, die bei uns bestellt haben.", "info": "Pflichtangabe nach UWG § 5b: Wie stellst du sicher, dass Bewertungen echt sind?" },
    { "type": "checkbox", "id": "autoplay", "label": "Automatisch weiterblättern", "default": true },
    { "type": "paragraph", "content": "Nur echte Kundenbewertungen verwenden. Blöcke mit „Beispiel“ sind ausschließlich im Theme-Editor sichtbar; ist kein echter Block vorhanden, wird die Sektion im Shop ausgeblendet." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Bewertung",
      "settings": [
        { "type": "checkbox", "id": "sample", "label": "Beispiel (nur im Editor sichtbar)", "default": true },
        { "type": "range", "id": "rating", "label": "Sterne", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Hier steht die Bewertung eines echten Kunden." },
        { "type": "text", "id": "name", "label": "Name (z. B. Vorname + Initial)", "default": "Kunde" },
        { "type": "text", "id": "product", "label": "Gekauftes Produkt" },
        { "type": "text", "id": "date", "label": "Datum" },
        { "type": "checkbox", "id": "verified", "label": "Verifizierter Kauf", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Bewertungen", "blocks": [{ "type": "review" }] }]
}
{% endschema %}
