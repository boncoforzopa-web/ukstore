{%- comment -%} Double opt-in sign-up. Only shown once e-mail sending is set up, so the form never pretends to work. {%- endcomment -%}
{%- if shop.forms_ready -%}
<section class="tw-newsletter" id="newsletter">
  <div class="tw-wrap tw-newsletter__grid">
    <div class="tw-newsletter__copy">
      <h2 class="tw-h2">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    {%- form 'customer', class: 'tw-newsletter__form', id: 'tw-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="tw-success" role="status">{% render 'tw-icon', name: 'check', size: 18 %} Check your inbox and confirm your email address to finish signing up.</p>
      {%- else -%}
        {%- if form.errors -%}<p class="tw-error" role="alert">Enter a valid email address.</p>{%- endif -%}
        <div class="tw-newsletter__field">
          <label for="tw-nl-email" class="visually-hidden">Email address</label>
          <input id="tw-nl-email" type="email" name="contact[email]" required autocomplete="email" placeholder="Email address" value="{{ form.email }}">
          <button type="submit" class="tw-btn tw-btn--light">Sign up</button>
        </div>
        <label class="tw-check">
          <input type="checkbox" name="contact[accepts_marketing]" value="true" required>
          <span class="tw-check__box" aria-hidden="true">{% render 'tw-icon', name: 'check', size: 14 %}</span>
          <span class="tw-small">I agree to receive emails from {{ settings.brand_name }}. I can unsubscribe at any time.{% if settings.privacy_page != blank %} <a href="{{ settings.privacy_page.url }}">Privacy policy</a>{% endif %}</span>
        </label>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals and seasonal offers by email" },
    { "type": "text", "id": "text", "label": "Text", "default": "An occasional email when new collections arrive or a sale starts." }
  ]
}
{% endschema %}
