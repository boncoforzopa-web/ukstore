<section class="tw-section tw-games">
  <div class="tw-wrap">
    {% render 'tw-section-head', kicker: section.settings.kicker, heading: section.settings.heading, center: true %}
    <div class="tw-games__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign url = block.settings.link | default: col.url | default: routes.all_products_collection_url
        -%}
        <a class="tw-gtile" href="{{ url }}" style="--h: {{ block.settings.hue }}" data-reveal {{ block.shopify_attributes }}>
          <span class="tw-gtile__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 18vw, 60vw', alt: '' }}
            {%- elsif block.settings.asset != blank -%}
              <img src="{{ block.settings.asset | asset_url }}" width="900" height="900" loading="lazy" alt="">
            {%- endif -%}
          </span>
          <span class="tw-gtile__body">
            <span>
              <span class="tw-gtile__name">{{ block.settings.title }}</span>
            </span>
            <span class="tw-gtile__go" aria-hidden="true">{% render 'tw-icon', name: 'arrow-right', size: 16 %}</span>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Spiele-Kacheln",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Sortiment" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Nach Spiel shoppen" }
  ],
  "blocks": [
    {
      "type": "game",
      "name": "Spiel",
      "settings": [
        { "type": "text", "id": "title", "label": "Name", "default": "Pokémon" },
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "url", "id": "link", "label": "Link (optional, sonst Kollektion)" },
        { "type": "image_picker", "id": "image", "label": "Bild (freigestellt, PNG)" },
        { "type": "text", "id": "asset", "label": "Oder Theme-Asset (Dateiname)" },
        { "type": "range", "id": "hue", "label": "Farbton", "min": 0, "max": 360, "step": 5, "default": 40 }
      ]
    }
  ],
  "presets": [{ "name": "Spiele-Kacheln" }]
}
{% endschema %}
