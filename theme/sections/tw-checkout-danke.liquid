{%- comment -%} Thank-you page after payment. `order` is the paid order; `pending` is true while the payment is still processing. {%- endcomment -%}
<section class="tw-co tw-co--done">
  <div class="tw-wrap tw-co__layout">
    <div class="tw-co__form">
      <div class="tw-co__step tw-co__hero">
        <span class="tw-co__check" aria-hidden="true">{% render 'tw-icon', name: 'check', size: 26 %}</span>
        <h1 class="tw-h1">{% if pending %}Your payment is being processed{% else %}Thank you{% if order.first_name != blank %}, {{ order.first_name }}{% endif %}. Your order is confirmed.{% endif %}</h1>
        {%- if pending -%}
          <p>Your payment provider is still confirming the payment. As soon as it comes through we will email your order confirmation to <b>{{ order.email }}</b>.</p>
        {%- else -%}
          <p>Order number <b>{{ order.number }}</b>. We have sent a confirmation to <b>{{ order.email }}</b>.</p>
          <p class="tw-muted">{% if order.all_pre %}This is a pre-order. We will email you tracking details when it is sent.{% elsif order.has_pre %}Your order includes pre-order items. We will email you about how it will be sent.{% else %}We will email you tracking details when your parcel leaves us.{% endif %}</p>
        {%- endif -%}
        <div class="tw-co__ctas">
          <a href="{{ routes.root_url }}" class="tw-btn tw-btn--gold">Continue shopping</a>
          {%- if order.receipt_url -%}<a href="{{ order.receipt_url }}" target="_blank" rel="noopener" class="tw-btn tw-btn--ghost">View payment receipt</a>{%- endif -%}
        </div>
      </div>

      <div class="tw-co__step">
        <h2 class="tw-h3">Delivery and payment</h2>
        <div class="tw-co__grid">
          <div><p class="tw-small tw-muted">Delivery address</p><p>{{ order.ship_name }}<br>{{ order.address.line1 }}{% if order.address.line2 != blank %}<br>{{ order.address.line2 }}{% endif %}<br>{{ order.address.city }}<br>{{ order.address.postal_code }}<br>United Kingdom</p></div>
          <div><p class="tw-small tw-muted">Payment</p><p>{{ order.payment_label }}<br><span class="tw-muted tw-small">{{ order.created | date: '%-d %B %Y, %H:%M' }}</span></p></div>
        </div>
        <p class="tw-small tw-muted">A question about your order? Reply to the confirmation email{% if settings.contact_email != blank %} or write to <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>{% endif %}.</p>
      </div>
    </div>

    <aside class="tw-co__aside">
      <div class="tw-co__summary">
        <h2 class="tw-h3">Your items</h2>
        <ul class="tw-co__items" role="list">
          {%- for l in order.lines -%}
            <li class="tw-co__item">
              <span class="tw-co__thumb">{% if l.image %}<img src="{{ l.image }}" alt="" width="64" height="80">{% endif %}</span>
              <span class="tw-co__item-body"><span class="tw-co__item-title">{{ l.title }}</span><span class="tw-small tw-muted">Quantity {{ l.quantity }}</span>{% if l.preorder %}<span class="tw-small tw-line__pre">Pre-order{% if l.release != blank %}, expected {{ l.release }}{% endif %}</span>{% endif %}</span>
              <strong class="tw-co__item-price">{{ l.line_total | money }}</strong>
            </li>
          {%- endfor -%}
        </ul>
        <div class="tw-co__sums">
          <div class="tw-sumrow"><span>Delivery</span><span>{% if order.shipping > 0 %}{{ order.shipping | money }}{% else %}Free{% endif %}</span></div>
          <div class="tw-sumrow tw-co__total"><span>Total</span><strong>{{ order.total | money }}</strong></div>
        </div>
      </div>
    </aside>
  </div>
</section>

{% schema %}
{ "name": "Order confirmed", "settings": [] }
{% endschema %}
