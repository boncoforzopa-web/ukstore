{%- comment -%} Thank-you page after payment. `order` is the paid order; `pending` true while the payment is still processing. {%- endcomment -%}
<section class="tw-co tw-co--danke">
  <div class="tw-wrap tw-co__layout">
    <div class="tw-co__form">
      <section class="tw-co__step tw-glass tw-co__hero">
        <span class="tw-co__check">{% render 'tw-icon', name: 'check', size: 28 %}</span>
        <p class="tw-kicker">{% if pending %}Zahlung wird verarbeitet{% else %}Bestellung {{ order.number }}{% endif %}</p>
        <h1 class="tw-h2">{% if pending %}Fast geschafft{% else %}Danke{% if order.first_name != blank %}, {{ order.first_name }}{% endif %}! Deine Bestellung ist bei uns.{% endif %}</h1>
        <p class="tw-muted">{% if pending %}Dein Zahlungsanbieter bestätigt die Zahlung noch. Sobald sie bei uns ist, bekommst du die Bestellbestätigung per E-Mail an <b>{{ order.email }}</b>.{% else %}Eine Bestätigung mit allen Details (inkl. AGB und Widerrufsbelehrung als PDF) ist unterwegs an <b>{{ order.email }}</b>.{% endif %}</p>
        {%- unless pending -%}
        <div class="tw-co__steps">
          <span class="is-on"><i>✓</i>Bestellt</span><span class="is-on"><i>✓</i>{% if order.all_pre %}Reserviert{% else %}Wird gepackt{% endif %}</span><span><i>3</i>Versendet</span><span><i>4</i>Zugestellt</span>
        </div>
        <p class="tw-co__eta">{% render 'tw-icon', name: 'truck', size: 18 %} {% if order.all_pre %}Versand zum Erscheinungstermin – du bekommst dann sofort die Sendungsnummer{% elsif order.has_pre %}Lagernde Artikel und Vorbestellungen versenden wir gemeinsam nach Erscheinen{% else %}Voraussichtliche Lieferung <b>{{ order.delivery_window }}</b>{% endif %}</p>
        {%- endunless -%}
        <div class="tw-co__ctas">
          <a href="/collections/neuheiten" class="tw-btn tw-btn--gold tw-btn--lg tw-btn--shimmer">Weiter stöbern {% render 'tw-icon', name: 'arrow-right', size: 18 %}</a>
          {%- if order.receipt_url -%}<a href="{{ order.receipt_url }}" target="_blank" rel="noopener" class="tw-btn tw-btn--glass tw-btn--lg">Zahlungsbeleg</a>{%- endif -%}
        </div>
      </section>

      <section class="tw-co__step tw-glass">
        <h2 class="tw-h3">Lieferung &amp; Zahlung</h2>
        <div class="tw-co__grid">
          <div><p class="tw-kicker">Lieferadresse</p><p>{{ order.ship_name }}<br>{{ order.address.line1 }}{% if order.address.line2 != blank %}<br>{{ order.address.line2 }}{% endif %}<br>{{ order.address.postal_code }} {{ order.address.city }}<br>Deutschland</p></div>
          <div><p class="tw-kicker">Zahlung</p><p>{{ order.payment_label }}<br><span class="tw-muted tw-small">{{ order.created | date: '%d.%m.%Y, %H:%M' }} Uhr</span></p></div>
        </div>
        <p class="tw-small tw-muted">Fragen zu deiner Bestellung? Antworte einfach auf die Bestätigungs-E-Mail oder schreib an <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>.</p>
      </section>
    </div>

    <aside class="tw-co__aside">
      <div class="tw-co__summary tw-glass">
        <p class="tw-h3">Deine Artikel</p>
        <ul class="tw-co__items" role="list">
          {%- for l in order.lines -%}
            <li class="tw-co__item">
              <span class="tw-co__thumb">{% if l.image %}<img src="{{ l.image }}" alt="" width="64" height="64">{% endif %}<b class="tw-co__qty">{{ l.quantity }}</b></span>
              <span class="tw-co__item-body"><a href="/products/{{ l.handle }}" class="tw-co__item-title">{{ l.title }}</a>{% if l.preorder %}<span class="tw-chip tw-chip--gold tw-chip--sm">Vorbestellung{% if l.release != blank %} · {{ l.release }}{% endif %}</span>{% endif %}</span>
              <strong class="tw-co__item-price">{{ l.line_total | money_without_currency | strip | append: ' €' }}</strong>
            </li>
          {%- endfor -%}
        </ul>
        <div class="tw-co__sums">
          <div class="tw-sumrow"><span>Versand</span>{% if order.shipping > 0 %}<span>{{ order.shipping | money_without_currency | strip | append: ' €' }}</span>{% else %}<span class="tw-co__free">Kostenlos</span>{% endif %}</div>
          <div class="tw-sumrow tw-co__total"><span>Gesamt</span><strong>{{ order.total | money_without_currency | strip | append: ' €' }}</strong></div>
          <p class="tw-small tw-muted">inkl. MwSt.</p>
        </div>
      </div>
    </aside>
  </div>
</section>
{% schema %}
{ "name": "Checkout – Danke", "settings": [] }
{% endschema %}
