{%- comment -%} A row of products from one collection. Renders nothing while that collection is empty. {%- endcomment -%}
{%- assign c = section.settings.collection -%}
{%- if c != blank and c.products_count > 0 -%}
<section class="tw-section tw-products">
  <div class="tw-wrap">
    {% render 'tw-section-head', heading: section.settings.heading, text: section.settings.text, link: c.url, link_label: section.settings.link_label %}
    <div class="tw-grid tw-grid--4">
      {%- for product in c.products limit: section.settings.limit -%}
        {% render 'tw-product-card', product: product, index: forloop.index0 %}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product row",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "View all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 4 }
  ]
}
{% endschema %}
