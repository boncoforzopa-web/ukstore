<section class="tw-section tw-stats" id="{{ section.settings.anchor | default: 'tw-stats' }}">
  <div class="tw-wrap">
    <ul class="tw-stats__row tw-glass" role="list">
      {%- for block in section.blocks -%}
        <li class="tw-stats__item" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <p class="tw-stats__num">
            {%- liquid
              assign v = block.settings.value | times: 1
              if v >= 1000
                assign thou = v | divided_by: 1000
                assign rest = v | modulo: 1000 | prepend: '00' | slice: -3, 3
                assign vtxt = thou | append: '.' | append: rest
              else
                assign vtxt = v
              endif
              assign suf_len = block.settings.suffix | size
            -%}
            {{- block.settings.prefix -}}<span data-count="{{ v }}">{{ vtxt }}</span>{% if suf_len > 2 %}<span class="tw-stats__suf">{{ block.settings.suffix }}</span>{% else %}{{ block.settings.suffix }}{% endif %}
          </p>
          <p class="tw-stats__label">{{ block.settings.label }}</p>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Live-Statistiken",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anker-ID", "default": "tw-stats" },
    { "type": "paragraph", "content": "Nur belegbare Zahlen verwenden – unzutreffende Werbeaussagen sind in Deutschland abmahnfähig (UWG)." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Kennzahl",
      "settings": [
        { "type": "text", "id": "prefix", "label": "Präfix" },
        { "type": "number", "id": "value", "label": "Zahl", "default": 100 },
        { "type": "text", "id": "suffix", "label": "Suffix", "default": "%" },
        { "type": "text", "id": "label", "label": "Beschriftung", "default": "originalverpackt" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Live-Statistiken", "blocks": [{ "type": "stat" }, { "type": "stat" }, { "type": "stat" }] }]
}
{% endschema %}
