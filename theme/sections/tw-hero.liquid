<section class="tw-hero{% if section.settings.festive %} tw-hero--festive{% endif %}" data-hero>
  {%- if section.settings.festive -%}
    <canvas class="tw-hero__snow" data-hero-snow aria-hidden="true"></canvas>
    <canvas class="tw-hero__festoon" data-hero-festoon aria-hidden="true"></canvas>
  {%- endif -%}
  <div class="tw-wrap tw-hero__grid">
    <div class="tw-hero__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="tw-hero__eyebrow"><span aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="tw-hero__title">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<p class="tw-hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="tw-hero__ctas">
        {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link }}" class="tw-btn tw-btn--light tw-btn--lg">{{ section.settings.cta_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a href="{{ section.settings.cta2_link }}" class="tw-btn tw-btn--outline-light tw-btn--lg">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
    <div class="tw-hero__media">
      {%- liquid
        assign hp = section.settings.product
        assign hp_img = blank
        assign lights = 0
        if hp != blank
          assign hp_i = section.settings.product_image | default: 1 | minus: 1
          assign hp_img = hp.media[hp_i] | default: hp.featured_media
          for b in section.blocks
            if b.type == 'light'
              assign lights = lights | plus: 1
            endif
          endfor
        endif
      -%}
      <div class="tw-cane tw-cane--hero" data-cane="classic">
      <div class="tw-arch tw-arch--hero{% if hp_img != blank or section.settings.image != blank %} tw-arch--photo{% endif %}{% if lights > 1 %} tw-arch--lights{% endif %}">
        {%- if lights > 1 -%}
          {%- assign n = 0 -%}
          {%- for b in section.blocks -%}
            {%- if b.type != 'light' -%}{%- continue -%}{%- endif -%}
            {%- assign li = b.settings.image | default: 1 | minus: 1 -%}
            {%- assign limg = hp.media[li] -%}
            {%- if limg == blank -%}{%- continue -%}{%- endif -%}
            {%- capture lalt -%}{{ hp.title }} with {{ b.settings.name | downcase }} lights{%- endcapture -%}
            {%- if n == 0 -%}
              {{ limg | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 640, 800, 1000, 1600', sizes: '(min-width: 1200px) 520px, (min-width: 768px) 42vw, 86vw', alt: lalt, class: 'tw-hero__photo is-active', data-light: n }}
            {%- else -%}
              {{ limg | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'low', widths: '480, 640, 800, 1000, 1600', sizes: '(min-width: 1200px) 520px, (min-width: 768px) 42vw, 86vw', alt: lalt, class: 'tw-hero__photo', data-light: n, aria-hidden: 'true' }}
            {%- endif -%}
            {%- assign n = n | plus: 1 -%}
          {%- endfor -%}
          <span class="tw-hero__glow" aria-hidden="true"></span>
        {%- elsif hp_img != blank -%}
          {{ hp_img | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 640, 800, 1000, 1600', sizes: '(min-width: 1200px) 520px, (min-width: 768px) 42vw, 82vw', alt: hp.title, class: 'tw-hero__photo' }}
          <span class="tw-hero__glow" aria-hidden="true"></span>
        {%- elsif section.settings.image != blank -%}
          <picture>
            {%- if section.settings.image_mobile != blank -%}<source media="(max-width: 767px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">{%- endif -%}
            {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}
          </picture>
        {%- else -%}
          <svg class="tw-hero__art" viewBox="0 0 520 640" preserveAspectRatio="xMidYMax slice" role="img" aria-label="Illustration of a decorated Christmas tree with presents underneath">
            <defs><radialGradient id="hero-glow" cx="50%" cy="48%" r="55%"><stop offset="0" stop-color="#E9D29A" stop-opacity=".34"/><stop offset="1" stop-color="#E9D29A" stop-opacity="0"/></radialGradient></defs>
            <rect width="520" height="640" fill="#10261D"/><rect width="520" height="640" fill="url(#hero-glow)"/>
            <path d="M0 520h520v120H0Z" fill="#0C1E17"/><ellipse cx="260" cy="524" rx="190" ry="26" fill="#9B1C31"/><ellipse cx="260" cy="520" rx="150" ry="16" fill="#B02A41"/>
            <rect x="246" y="456" width="28" height="60" fill="#5B3F25"/>
            <path d="M260 268l124 188H136Z" fill="#285E46"/><path d="M260 184l98 146H162Z" fill="#2F6B50"/><path d="M260 108l72 116H188Z" fill="#3A7A5C"/>
            <path d="M260 268l124 188H260ZM260 184l98 146h-98ZM260 108l72 116h-72Z" fill="#0C1E17" opacity=".16"/>
            <g fill="none" stroke="#E9D29A" stroke-width="1.500" opacity=".9"><path d="M212 190q48 26 104 4"/><path d="M186 292q72 36 152 4"/><path d="M158 410q100 46 208 4"/><path d="M226 152q30 14 62 2"/><path d="M172 348q88 38 180 2"/></g>
            <g fill="#F6E4AE">
              <circle class="tw-twinkle" cx="232" cy="198" r="4"/><circle cx="262" cy="205" r="4"/><circle class="tw-twinkle" style="animation-delay:1.100s" cx="294" cy="200" r="4"/>
              <circle cx="206" cy="300" r="4"/><circle class="tw-twinkle" style="animation-delay:.600s" cx="240" cy="311" r="4"/><circle cx="276" cy="314" r="4"/><circle class="tw-twinkle" style="animation-delay:1.900s" cx="312" cy="306" r="4"/>
              <circle class="tw-twinkle" style="animation-delay:1.400s" cx="184" cy="421" r="4"/><circle cx="222" cy="432" r="4"/><circle class="tw-twinkle" style="animation-delay:.300s" cx="262" cy="437" r="4"/><circle cx="302" cy="433" r="4"/><circle class="tw-twinkle" style="animation-delay:2.300s" cx="340" cy="423" r="4"/>
              <circle cx="244" cy="160" r="3.500"/><circle class="tw-twinkle" style="animation-delay:.900s" cx="272" cy="160" r="3.500"/><circle cx="210" cy="362" r="4"/><circle class="tw-twinkle" style="animation-delay:1.700s" cx="262" cy="372" r="4"/><circle cx="316" cy="364" r="4"/>
            </g>
            <g fill="#C8475B"><circle cx="246" cy="240" r="8"/><circle cx="298" cy="262" r="8"/><circle cx="214" cy="336" r="8"/><circle cx="322" cy="392" r="8"/><circle cx="238" cy="398" r="8"/></g>
            <g fill="#F7F2E8"><circle cx="278" cy="232" r="7"/><circle cx="228" cy="266" r="7"/><circle cx="288" cy="344" r="7"/><circle cx="192" cy="388" r="7"/><circle cx="346" cy="446" r="7"/></g>
            <g fill="#D9C08A"><circle cx="258" cy="286" r="7"/><circle cx="330" cy="330" r="7"/><circle cx="274" cy="402" r="7"/><circle cx="170" cy="440" r="7"/></g>
            <path d="M260 66l9 20 22 2-17 15 5 22-19-11-19 11 5-22-17-15 22-2Z" fill="#E9D29A"/>
            <rect x="120" y="474" width="78" height="54" fill="#9B1C31"/><rect x="152" y="474" width="14" height="54" fill="#E9D29A"/><path d="M159 474c-8-18-24-18-26-8 2 9 14 9 26 8Zm0 0c8-18 24-18 26-8-2 9-14 9-26 8Z" fill="#E9D29A"/>
            <rect x="330" y="462" width="62" height="66" fill="#B8975A"/><rect x="330" y="488" width="62" height="10" fill="#17362B"/><rect x="356" y="462" width="10" height="66" fill="#17362B"/>
            <rect x="380" y="492" width="56" height="36" fill="#F7F2E8"/><rect x="404" y="492" width="8" height="36" fill="#9B1C31"/>
          </svg>
        {%- endif -%}
      </div>
      </div>
      {%- if hp != blank -%}
        {%- liquid
          assign hv = hp.selected_or_first_available_variant
          assign save = 0
          if hp.compare_at_price > hp.price
            assign save = hp.compare_at_price | minus: hp.price | times: 100 | divided_by: hp.compare_at_price
          endif
        -%}
        <div class="tw-hero__tag">
          <span class="tw-hero__tag-top">
            <span class="tw-hero__tag-label">{{ section.settings.product_label | default: 'Featured' }}</span>
            {%- if save > 0 -%}<span class="tw-hero__tag-save">Save {{ save }}%</span>{%- endif -%}
          </span>
          <a class="tw-hero__tag-title" href="{{ hp.url }}">{{ section.settings.product_title | default: hp.title }}<span class="tw-hero__tag-hit" aria-hidden="true"></span></a>
          {%- unless hp.has_only_default_variant -%}
            <span class="tw-hero__tag-sizes">{% for v in hp.variants %}<span>{{ v.title | replace: "'", " ft" }}</span>{% endfor %}</span>
          {%- endunless -%}
          {%- if lights > 1 -%}
            <span class="tw-hero__lights" data-hero-lights>
              <span class="tw-hero__lights-label">Lights: <strong data-light-name>{% for b in section.blocks %}{% if b.type == 'light' %}{{ b.settings.name }}{% break %}{% endif %}{% endfor %}</strong></span>
              <span class="tw-hero__swatches">
                {%- assign n = 0 -%}
                {%- for b in section.blocks -%}
                  {%- if b.type != 'light' -%}{%- continue -%}{%- endif -%}
                  <button type="button" class="tw-hero__swatch{% if n == 0 %} is-active{% endif %}{% if b.settings.multi %} tw-hero__swatch--multi{% endif %}" style="--c: {{ b.settings.color }}" data-light-btn="{{ n }}" data-name="{{ b.settings.name | escape }}" aria-pressed="{% if n == 0 %}true{% else %}false{% endif %}" aria-label="Show {{ b.settings.name | escape }} lights" {{ b.shopify_attributes }}><i></i></button>
                  {%- assign n = n | plus: 1 -%}
                {%- endfor -%}
              </span>
            </span>
          {%- endif -%}
          <span class="tw-hero__tag-foot">
            <span class="tw-hero__tag-price">{% if hp.price_varies %}<span>From</span> {% endif %}{{ hp.price | money }}{% if hp.compare_at_price > hp.price %} <s><span class="visually-hidden">was </span>{{ hp.compare_at_price | money }}</s>{% endif %}</span>
            <span class="tw-hero__tag-cta" aria-hidden="true">Shop now {% render 'tw-icon', name: 'arrow-right', size: 16 %}</span>
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.festive -%}
<script>
(function () {
  var hero = document.currentScript.previousElementSibling;
  while (hero && !(hero.matches && hero.matches('.tw-hero'))) hero = hero.previousElementSibling;
  var c = hero && hero.querySelector('[data-hero-snow]');
  if (!c || !c.getContext || (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) return;
  var ctx = c.getContext('2d'), flakes = [], w = 0, h = 0, raf = 0, on = false, last = 0;
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  function size() {
    w = hero.clientWidth; h = hero.clientHeight; c.width = w * dpr; c.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var n = Math.round(Math.min(70, w / 18));
    while (flakes.length < n) flakes.push(make(true));
    flakes.length = n;
  }
  function make(anywhere) {
    var z = Math.random();
    return { x: Math.random() * w, y: anywhere ? Math.random() * h : -6, r: .7 + z * 1.900, v: 9 + z * 22, sway: 6 + Math.random() * 14, ph: Math.random() * 6.280, a: .18 + z * .5 };
  }
  function tick(t) {
    var dt = Math.min(.05, (t - last) / 1000 || 0); last = t;
    ctx.clearRect(0, 0, w, h); ctx.fillStyle = '#F7F2E8';
    for (var i = 0; i < flakes.length; i++) {
      var f = flakes[i]; f.y += f.v * dt; f.ph += dt * .7;
      if (f.y > h + 6) flakes[i] = f = make(false);
      ctx.globalAlpha = f.a; ctx.beginPath(); ctx.arc(f.x + Math.sin(f.ph) * f.sway, f.y, f.r, 0, 6.283); ctx.fill();
    }
    if (on) raf = requestAnimationFrame(tick);
  }
  function start() { if (on || document.hidden) return; on = true; last = performance.now(); raf = requestAnimationFrame(tick); }
  function stop() { on = false; cancelAnimationFrame(raf); }
  size(); window.addEventListener('resize', size);
  document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else start(); });
  if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { if (e[0].isIntersecting) start(); else stop(); }).observe(hero); else start();
})();
</script>
<script>
/* Festoon lights. Glass bulbs on a cable, drawn on a canvas so each bulb can glow, swing and change colour on its own. */
(function () {
  var hero = document.currentScript.previousElementSibling;
  while (hero && !(hero.matches && hero.matches('.tw-hero'))) hero = hero.previousElementSibling;
  var c = hero && hero.querySelector('[data-hero-festoon]');
  if (!c || !c.getContext) return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ctx = c.getContext('2d'), dpr = Math.min(window.devicePixelRatio || 1, 2);
  var W = 0, H = 120, spans = [], bulbs = [], raf = 0, on = false, t0 = 0, now = 0, last = 0, lit = false, litAt = 0;
  var WARM = [255, 214, 150];
  /* Multicolour: classic heritage glass tones, softened so they read as light, not as flat paint */
  var HERITAGE = [[255, 92, 96], [255, 183, 77], [94, 214, 160], [96, 150, 255], [255, 214, 150]];
  var pointer = { x: -999, y: -999, vx: 0, t: 0 }, ripples = [], glintAt = 0;

  function hex(h) { h = (h || '').trim().replace('#', ''); if (h.length === 3) h = h.replace(/./g, '$&$&'); var n = parseInt(h, 16); return isNaN(n) ? WARM.slice() : [n >> 16 & 255, n >> 8 & 255, n & 255]; }
  function mix(a, b, k) { return [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k, a[2] + (b[2] - a[2]) * k]; }
  function rgba(col, a) { return 'rgba(' + (col[0] | 0) + ',' + (col[1] | 0) + ',' + (col[2] | 0) + ',' + a.toFixed(3) + ')'; }
  /* A coloured light still looks white-hot at the filament; soften very saturated swatches a touch */
  function glass(col) { return mix(col, [255, 244, 228], .12); }
  function colourFor(i, theme) { return theme.multi ? HERITAGE[i % HERITAGE.length] : glass(theme.col); }

  var theme = { col: WARM, multi: false };
  var first = hero.querySelector('[data-light-btn]');
  if (first) theme = { col: hex(first.style.getPropertyValue('--c')), multi: first.classList.contains('tw-hero__swatch--multi') };

  function layout() {
    W = hero.clientWidth;
    c.width = W * dpr; c.height = H * dpr; c.style.height = H + 'px'; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    var span = W < 640 ? 132 : W < 1100 ? 164 : 190, n = Math.ceil(W / span) + 1, off = (W - (n - 1) * span) / 2;
    var per = W < 640 ? 3 : 4, old = bulbs;
    spans = []; bulbs = [];
    for (var s = 0; s < n - 1; s++) {
      var x0 = off + s * span;
      spans.push({ x0: x0, x1: x0 + span, sag: 24 + (s % 2) * 3, ph: s * 1.7 });
      for (var k = 0; k < per; k++) {
        var i = bulbs.length, prev = old[i];
        bulbs.push({
          s: s, u: (k + .5) / per, x: 0, y: 0,
          th: prev ? prev.th : 0, w: prev ? prev.w : 0,
          col: prev ? prev.col : colourFor(i, theme), from: null, to: null, ct: 0,
          ph: Math.random() * 6.28, sp: .55 + Math.random() * .5, flick: 0
        });
      }
    }
    if (reduce) draw();
  }

  function cableY(sp, u, t) { var sag = sp.sag + Math.sin(t * .7 + sp.ph) * 1.4; return 3 + 4 * sag * u * (1 - u); }

  function setTheme(next) {
    theme = next;
    var box = hero.querySelector('.tw-arch--hero'), r = box && box.getBoundingClientRect(), hr = hero.getBoundingClientRect();
    var ox = r ? r.left - hr.left + r.width / 2 : W * .75;
    bulbs.forEach(function (b, i) {
      b.from = b.col; b.to = colourFor(i, theme);
      b.ct = now + Math.abs(b.x - ox) / 1.1; /* the colour travels outward from the tree at ~1100px/s */
    });
    if (reduce) { bulbs.forEach(function (b) { b.col = b.to; b.to = null; }); draw(); }
  }
  hero.addEventListener('tw:light', function (e) { setTheme({ col: hex(e.detail.color), multi: !!e.detail.multi }); });

  function intensity(b, i) {
    if (reduce) return 1;
    /* switch-on: left to right, each bulb catches with a quick filament flicker */
    var since = now - litAt - i * 34;
    if (!lit || since < 0) return .06;
    var on = since > 260 ? 1 : since < 60 ? .55 : since < 110 ? .18 : since < 170 ? .9 : .7;
    var v = on * (.86 + .14 * Math.sin(now / 1000 * b.sp * 2.4 + b.ph));
    /* a glint that runs along the string every few seconds */
    var gx = (now - glintAt) * .9 - 200;
    v += .32 * Math.exp(-Math.pow((b.x - gx) / 90, 2));
    /* brighter near the pointer */
    var dx = b.x - pointer.x, dy = b.y - pointer.y;
    v += .25 * Math.exp(-(dx * dx + dy * dy) / 5000);
    /* tap ripples */
    for (var r = 0; r < ripples.length; r++) {
      var rp = ripples[r], age = (now - rp.t) / 1000, d = Math.abs(b.x - rp.x);
      v += .7 * Math.exp(-Math.pow((d - age * 700) / 60, 2)) * Math.max(0, 1 - age / 1.6);
    }
    /* the odd real-filament flicker */
    if (b.flick > now) v *= .55; else if (Math.random() < .0004) b.flick = now + 70 + Math.random() * 90;
    /* flash as the new colour arrives */
    if (b.to) { var k = (now - b.ct) / 380; if (k > 0 && k < 1) v += .45 * Math.sin(k * Math.PI); }
    return Math.max(.06, Math.min(1.5, v));
  }

  function step(dt) {
    var t = now / 1000;
    if (now - glintAt > 6500 + W * 1.1) glintAt = now;
    ripples = ripples.filter(function (r) { return now - r.t < 1600; });
    pointer.vx *= Math.pow(.02, dt);
    bulbs.forEach(function (b) {
      var sp = spans[b.s]; b.x = sp.x0 + (sp.x1 - sp.x0) * b.u; b.y = cableY(sp, b.u, t);
      var wind = .05 * Math.sin(t * .6 + b.x * .004) + .025 * Math.sin(t * 1.7 + b.x * .013);
      var dx = b.x - pointer.x, dy = b.y + 14 - pointer.y;
      if (dx * dx + dy * dy < 4900) b.w += pointer.vx * .0035 * (1 - Math.sqrt(dx * dx + dy * dy) / 70);
      b.w += (-38 * (b.th - wind) - 1.6 * b.w) * dt;
      b.w = Math.max(-6, Math.min(6, b.w)); b.th += b.w * dt; b.th = Math.max(-.9, Math.min(.9, b.th));
      if (b.to) {
        var k = (now - b.ct) / 380;
        if (k >= 1) { b.col = b.to; b.to = null; } else if (k > 0) b.col = mix(b.from, b.to, k);
      }
    });
  }

  function draw() {
    var t = now / 1000;
    ctx.clearRect(0, 0, W, H);
    if (reduce) bulbs.forEach(function (b) { var sp = spans[b.s]; b.x = sp.x0 + (sp.x1 - sp.x0) * b.u; b.y = cableY(sp, b.u, 0); });
    /* cable: a dark twisted flex with a faint brass sheen */
    ctx.lineCap = 'round';
    spans.forEach(function (sp) {
      ctx.beginPath();
      for (var j = 0; j <= 24; j++) { var u = j / 24, x = sp.x0 + (sp.x1 - sp.x0) * u, y = cableY(sp, u, reduce ? 0 : t); if (j) ctx.lineTo(x, y); else ctx.moveTo(x, y); }
      ctx.strokeStyle = 'rgba(6,10,8,.85)'; ctx.lineWidth = 2.4; ctx.stroke();
      ctx.strokeStyle = 'rgba(214,190,140,.22)'; ctx.lineWidth = .8; ctx.stroke();
    });
    ctx.strokeStyle = 'rgba(200,170,110,.8)'; ctx.lineWidth = 1.2;
    spans.forEach(function (sp, i) { ctx.beginPath(); ctx.arc(sp.x0, 2, 2.4, .2, Math.PI * 2.1); ctx.stroke(); if (i === spans.length - 1) { ctx.beginPath(); ctx.arc(sp.x1, 2, 2.4, .2, Math.PI * 2.1); ctx.stroke(); } });
    /* halos first, added together so neighbouring bulbs bloom into each other */
    ctx.globalCompositeOperation = 'lighter';
    var I = bulbs.map(intensity);
    bulbs.forEach(function (b, i) {
      var v = I[i], cx = b.x + Math.sin(b.th) * 16, cy = b.y + Math.cos(b.th) * 16;
      if (v < .1) return;
      var g = ctx.createRadialGradient(cx, cy, 0, cx, cy, 40);
      g.addColorStop(0, rgba(b.col, .22 * v)); g.addColorStop(.4, rgba(b.col, .06 * v)); g.addColorStop(1, rgba(b.col, 0));
      ctx.fillStyle = g; ctx.fillRect(cx - 40, cy - 40, 80, 80);
      g = ctx.createRadialGradient(cx, cy, 0, cx, cy, 15);
      g.addColorStop(0, rgba(b.col, .55 * v)); g.addColorStop(1, rgba(b.col, 0));
      ctx.fillStyle = g; ctx.fillRect(cx - 15, cy - 15, 30, 30);
    });
    ctx.globalCompositeOperation = 'source-over';
    /* bulbs: brass-rimmed socket, glass with a hot core, highlight */
    bulbs.forEach(function (b, i) {
      var v = I[i];
      ctx.save(); ctx.translate(b.x, b.y); ctx.rotate(-b.th);
      ctx.fillStyle = '#0b100d'; ctx.beginPath(); ctx.roundRect ? ctx.roundRect(-2.6, 0, 5.2, 8, 1.2) : ctx.rect(-2.6, 0, 5.2, 8); ctx.fill();
      ctx.fillStyle = 'rgba(200,170,110,.75)'; ctx.fillRect(-2.6, 6.6, 5.2, 1.4);
      ctx.beginPath();
      ctx.moveTo(-2.4, 8); ctx.bezierCurveTo(-6.4, 11, -6.6, 19, -3.6, 22.5); ctx.quadraticCurveTo(0, 25.4, 3.6, 22.5); ctx.bezierCurveTo(6.6, 19, 6.4, 11, 2.4, 8); ctx.closePath();
      var a = Math.min(1, v);
      var g = ctx.createRadialGradient(0, 16, 0, 0, 16, 8.5);
      g.addColorStop(0, rgba(mix(b.col, [255, 255, 255], .7), .3 + .7 * a));
      g.addColorStop(.55, rgba(b.col, .18 + .6 * a));
      g.addColorStop(1, rgba(mix(b.col, [30, 24, 16], .45), .3 + .45 * a));
      ctx.fillStyle = g; ctx.fill();
      ctx.strokeStyle = rgba(mix(b.col, [255, 255, 255], .5), .15 + .25 * a); ctx.lineWidth = .6; ctx.stroke();
      /* filament and its bloom */
      ctx.globalCompositeOperation = 'lighter';
      g = ctx.createRadialGradient(0, 15, 0, 0, 15, 6);
      g.addColorStop(0, rgba([255, 250, 240], .9 * a)); g.addColorStop(.35, rgba(b.col, .55 * a)); g.addColorStop(1, rgba(b.col, 0));
      ctx.fillStyle = g; ctx.fillRect(-6, 9, 12, 12);
      ctx.strokeStyle = rgba([255, 252, 245], .95 * a); ctx.lineWidth = .9;
      ctx.beginPath(); ctx.moveTo(-1.6, 12.5); ctx.lineTo(-1.2, 15.5); ctx.quadraticCurveTo(0, 17.2, 1.2, 15.5); ctx.lineTo(1.6, 12.5); ctx.stroke();
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = 'rgba(255,255,255,' + (.3 + .35 * a).toFixed(3) + ')';
      ctx.beginPath(); ctx.ellipse(-2.6, 13.6, .8, 2.6, .22, 0, 6.283); ctx.fill();
      ctx.restore();
    });
  }

  function tick(t) {
    var dt = Math.min(.04, (t - last) / 1000 || 0); last = t; now = t;
    if (!lit) { lit = true; litAt = now + 250; glintAt = now + 2600; }
    step(dt); draw();
    if (on) raf = requestAnimationFrame(tick);
  }
  function start() { if (on || document.hidden || reduce) return; on = true; last = performance.now(); raf = requestAnimationFrame(tick); }
  function stop() { on = false; cancelAnimationFrame(raf); }

  hero.addEventListener('pointermove', function (e) {
    var r = c.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top, ts = performance.now(), dt = Math.max(8, ts - pointer.t);
    if (pointer.x > -900) pointer.vx = Math.max(-3, Math.min(3, (x - pointer.x) / dt)) * 1000 / 16;
    pointer.x = x; pointer.y = y; pointer.t = ts;
  }, { passive: true });
  hero.addEventListener('pointerleave', function () { pointer.x = pointer.y = -999; pointer.vx = 0; });
  hero.addEventListener('pointerdown', function (e) {
    var r = c.getBoundingClientRect(), y = e.clientY - r.top;
    if (y < H) ripples.push({ x: e.clientX - r.left, t: now });
  });

  layout();
  var rt; window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(layout, 120); });
  if (reduce) { draw(); return; }
  document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else start(); });
  if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { if (e[0].isIntersecting) start(); else stop(); }).observe(hero); else start();
})();
</script>
{%- endif -%}

{%- if lights > 1 -%}
<script>
(function () {
  var root = document.currentScript.previousElementSibling;
  while (root && !(root.matches && root.matches('.tw-hero'))) root = root.previousElementSibling;
  if (!root || root.dataset.lightsReady) return;
  root.dataset.lightsReady = '1';
  var photos = root.querySelectorAll('.tw-hero__photo[data-light]');
  var btns = root.querySelectorAll('[data-light-btn]');
  var nameEl = root.querySelector('[data-light-name]');
  var media = root.querySelector('.tw-hero__media');
  var ms = {{ section.settings.cycle_seconds | default: 3 | times: 1000 }};
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var i = 0, timer = null, paused = false;
  root.style.setProperty('--light-ms', ms + 'ms');
  function show(n) {
    i = (n + photos.length) % photos.length;
    photos.forEach(function (p, k) { var on = k === i; p.classList.toggle('is-active', on); if (on) p.removeAttribute('aria-hidden'); else p.setAttribute('aria-hidden', 'true'); });
    btns.forEach(function (b, k) { var on = k === i; b.classList.toggle('is-active', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
    var b = btns[i];
    if (b) { var col = getComputedStyle(b).getPropertyValue('--c'); if (nameEl) nameEl.textContent = b.dataset.name; root.style.setProperty('--light', col); root.dispatchEvent(new CustomEvent('tw:light', { detail: { color: col, multi: b.classList.contains('tw-hero__swatch--multi') } })); }
    restartBar();
  }
  function restartBar() { root.classList.remove('is-ticking'); void root.offsetWidth; if (!paused && !reduce) root.classList.add('is-ticking'); }
  function start() { stop(); if (reduce || paused) return; timer = setInterval(function () { show(i + 1); }, ms); restartBar(); }
  function stop() { clearInterval(timer); timer = null; root.classList.remove('is-ticking'); }
  btns.forEach(function (b, k) { b.addEventListener('click', function () { show(k); start(); }); });
  [media].forEach(function (el) {
    if (!el) return;
    el.addEventListener('mouseenter', function () { paused = true; stop(); });
    el.addEventListener('mouseleave', function () { paused = false; start(); });
    el.addEventListener('focusin', function () { paused = true; stop(); });
    el.addEventListener('focusout', function () { paused = false; start(); });
  });
  document.addEventListener('visibilitychange', function () { if (document.hidden) stop(); else start(); });
  if ('IntersectionObserver' in window) new IntersectionObserver(function (e) { if (e[0].isIntersecting) start(); else stop(); }).observe(root);
  show(0); start();
})();
</script>
{%- endif -%}

