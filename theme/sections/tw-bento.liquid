<section class="tw-section tw-bento-section">
  <div class="tw-wrap">
    {% render 'tw-section-head', kicker: section.settings.kicker, heading: section.settings.heading, link: section.settings.link, link_label: section.settings.link_label %}
    <div class="tw-bento">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign url = c.url | default: block.settings.link | default: routes.all_products_collection_url -%}
        <a href="{{ url }}" class="tw-bento__tile tw-bento__tile--{{ forloop.index }} tw-glass" data-reveal style="--i: {{ forloop.index0 }}; --hue: {{ block.settings.hue }}" {{ block.shopify_attributes }}>
          <div class="tw-bento__media">
            {%- liquid
              assign pimg = blank
              if block.settings.image == blank
                if block.settings.product != blank and block.settings.product.featured_image
                  assign pimg = block.settings.product.featured_image
                elsif c != blank and c.image == blank
                  for p in c.products
                    if p.featured_image
                      assign pimg = p.featured_image
                      break
                    endif
                  endfor
                endif
              endif
            -%}
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: '' }}
            {%- elsif pimg != blank -%}
              {{ pimg | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 30vw, 60vw', alt: '', class: 'tw-bento__product' }}
            {%- elsif c.image != blank -%}
              {{ c.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: '' }}
            {%- else -%}
              {% render 'tw-art', type: block.settings.art, hue: block.settings.hue, label: block.settings.title, sub: 'Tawa Gold', uid: block.id %}
            {%- endif -%}
          </div>
          <div class="tw-bento__copy">
            <p class="tw-kicker">{{ block.settings.kicker }}</p>
            <h3 class="tw-bento__title">{{ block.settings.title }}</h3>
            <p class="tw-muted tw-bento__text">{{ block.settings.text }}</p>
          </div>
          <span class="tw-bento__arrow">{% render 'tw-icon', name: 'arrow-up-right', size: 22 %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorien (Bento)",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Kategorien" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Finde dein nächstes Sealed-Highlight" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Alle Kategorien" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Kachel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "url", "id": "link", "label": "Alternativer Link" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Kategorie" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Booster Boxes" },
        { "type": "text", "id": "text", "label": "Text", "default": "Displays mit 36 Boostern – versiegelt ab Werk." },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "product", "id": "product", "label": "oder Produktfoto", "info": "Leer lassen = Foto des ersten Produkts der Kollektion" },
        { "type": "select", "id": "art", "label": "Platzhalter-Grafik", "default": "booster", "options": [ { "value": "booster", "label": "Display" }, { "value": "etb", "label": "ETB" }, { "value": "tin", "label": "Tin" }, { "value": "pack", "label": "Booster-Pack" } ] },
        { "type": "range", "id": "hue", "label": "Farbton", "min": 0, "max": 360, "step": 5, "default": 265 }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Kategorien (Bento)", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
