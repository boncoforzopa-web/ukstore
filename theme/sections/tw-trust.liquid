<section class="tw-trust" aria-label="Shopping with us">
  <ul class="tw-wrap tw-trust__list" role="list">
    {%- for block in section.blocks -%}
      <li class="tw-trust__item">
        {% render 'tw-icon', name: block.settings.icon, size: 24 %}
        <div>
          <p class="tw-trust__title">{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.title }}</a>{% else %}{{ block.settings.title }}{% endif %}</p>
          {%- if block.settings.text != blank -%}<p class="tw-trust__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Service strip",
  "blocks": [
    { "type": "item", "name": "Benefit", "settings": [
      { "type": "text", "id": "icon", "label": "Icon (truck, return, lock, mail, shield, gift, clock)", "default": "truck" },
      { "type": "text", "id": "title", "label": "Heading" },
      { "type": "text", "id": "text", "label": "Detail" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ]
}
{% endschema %}
