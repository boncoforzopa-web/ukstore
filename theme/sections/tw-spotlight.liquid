{%- comment -%} Highlights one category and its sub-categories (designer ranges, limited editions, a season…). {%- endcomment -%}
{%- assign c = section.settings.collection -%}
{%- if c != blank -%}
<section class="tw-section tw-spotlight">
  <div class="tw-wrap tw-spotlight__grid">
    <div class="tw-spotlight__copy">
      <h2 class="tw-h2">{{ section.settings.heading | default: c.title }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      <a href="{{ c.url }}" class="tw-btn tw-btn--outline-light">{{ section.settings.cta_label }}</a>
    </div>
    <ul class="tw-spotlight__list" role="list">
      {%- for child in c.children -%}
        <li><a href="{{ child.url }}"><span>{{ child.title }}</span>{% render 'tw-icon', name: 'arrow-right', size: 18 %}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Collection spotlight",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "View the collection" }
  ]
}
{% endschema %}
