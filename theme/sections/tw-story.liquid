<section class="tw-section tw-story">
  <div class="tw-wrap tw-story__grid">
    <div class="tw-story__media">
      <div class="tw-cane tw-cane--story" data-cane="holly">
      <div class="tw-arch">
        {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '480, 640, 800, 1000', sizes: '(min-width: 768px) 380px, 240px', alt: section.settings.image_alt }}{%- else -%}{% render 'tw-art', type: section.settings.art %}{%- endif -%}
      </div>
      </div>
    </div>
    <div class="tw-story__copy">
      <h2 class="tw-h2">{{ section.settings.heading }}</h2>
      <div class="tw-rte">{{ section.settings.text }}</div>
      {%- if section.settings.cta_label != blank -%}<a href="{{ section.settings.cta_link }}" class="tw-btn tw-btn--ghost">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Photo (replaces the illustration)" },
    { "type": "text", "id": "image_alt", "label": "Photo description" },
    { "type": "text", "id": "art", "label": "Illustration", "default": "wreath" }
  ]
}
{% endschema %}
