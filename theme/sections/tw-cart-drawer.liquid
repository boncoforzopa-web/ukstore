<dialog class="tw-drawer tw-drawer--right" id="tw-cart" aria-label="Basket">
  <div class="tw-drawer__panel" id="tw-cart-inner" data-cart-inner>
    <div class="tw-drawer__head">
      <p class="tw-drawer__title">Your basket <span class="tw-muted">({{ cart.item_count }})</span></p>
      <button type="button" class="tw-iconbtn" data-close aria-label="Close basket">{% render 'tw-icon', name: 'close', size: 22 %}</button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="tw-drawer__body tw-cart-empty">
        <p class="tw-h3">Your basket is empty</p>
        <p class="tw-muted tw-small">Pick a category to start.</p>
        <ul class="tw-cart-empty__links" role="list">
          {%- for c in collections -%}{%- if c.featured -%}<li><a href="{{ c.url }}">{{ c.title }}{% render 'tw-icon', name: 'arrow-right', size: 16 %}</a></li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      {%- liquid
        assign threshold = shop.ship_free_from
        assign has_pre = false
        for item in cart.items
          if item.product.tags contains 'Pre-order'
            assign has_pre = true
          endif
        endfor
      -%}
      {%- if threshold > 0 and shop.ship_fee > 0 -%}
        {%- assign remaining = threshold | minus: cart.total_price -%}
        {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
        <div class="tw-ship">
          <p class="tw-small">{%- if remaining > 0 -%}Spend <strong>{{ remaining | money }}</strong> more for free delivery{%- else -%}{% render 'tw-icon', name: 'check', size: 16 %} You have <strong>free delivery</strong>{%- endif -%}</p>
          <div class="tw-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}" aria-label="Progress to free delivery"><span style="width: {{ pct }}%"></span></div>
        </div>
      {%- endif -%}

      <div class="tw-drawer__body">
        <ul class="tw-lines" role="list">
          {%- for item in cart.items -%}
            <li class="tw-line" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="tw-line__media tw-skeleton is-loaded">
                {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title, widths: '120, 240' }}{%- else -%}{% render 'tw-art', type: item.product.collections.first.art %}{%- endif -%}
              </a>
              <div class="tw-line__info">
                <a href="{{ item.url }}" class="tw-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="tw-muted tw-small">{{ item.variant.title }}</p>{%- endunless -%}
                {%- if item.product.tags contains 'Pre-order' -%}<p class="tw-small tw-line__pre">Pre-order</p>{%- endif -%}
                <p class="tw-muted tw-small">{{ item.final_price | money }} each</p>
                <div class="tw-line__row">
                  <div class="tw-qty" data-qty>
                    <button type="button" data-qty-minus aria-label="Decrease quantity">{% render 'tw-icon', name: 'minus', size: 16 %}</button>
                    <input type="number" inputmode="numeric" min="0" max="99" value="{{ item.quantity }}" data-line-qty aria-label="Quantity of {{ item.product.title | escape }}">
                    <button type="button" data-qty-plus aria-label="Increase quantity">{% render 'tw-icon', name: 'plus', size: 16 %}</button>
                  </div>
                  <div class="tw-line__price"><strong>{{ item.final_line_price | money }}</strong></div>
                </div>
                <button type="button" class="tw-linkbtn tw-small" data-line-remove>Remove<span class="visually-hidden"> {{ item.product.title | escape }}</span></button>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        {%- if has_pre -%}
          <p class="tw-note">Your basket includes pre-order items, which are sent when they arrive with us.{% if settings.preorder_page != blank %} <a href="{{ settings.preorder_page.url }}">How pre-orders work</a>{% endif %}</p>
        {%- endif -%}
      </div>

      <div class="tw-drawer__foot">
        <div class="tw-sumrow"><span>Subtotal</span><strong data-cart-total>{{ cart.total_price | money }}</strong></div>
        <p class="tw-muted tw-small">{% if settings.tax_note != blank %}{{ settings.tax_note }}. {% endif %}{% if shop.ship_fee > 0 %}Delivery is calculated at checkout.{% else %}Free UK delivery.{% endif %}</p>
        <form action="{{ routes.cart_url }}" method="post">
          {%- if cart.total_price < min_order -%}
            <p class="tw-note">The minimum order is {{ min_order | money }}. Add {{ min_order | minus: cart.total_price | money }} more to check out.</p>
          {%- else -%}
            <button type="submit" name="checkout" class="tw-btn tw-btn--gold tw-btn--block tw-btn--lg">{% render 'tw-icon', name: 'lock', size: 18 %} Checkout</button>
          {%- endif -%}
        </form>
        <div class="tw-drawer__links">
          <a href="{{ routes.cart_url }}">View basket</a>
          <button type="button" class="tw-linkbtn" data-close>Continue shopping</button>
        </div>
      </div>
    {%- endif -%}
    <div class="tw-drawer__loading" aria-hidden="true"><span></span><span></span><span></span></div>
  </div>
</dialog>

{% schema %}
{ "name": "Basket drawer", "settings": [] }
{% endschema %}
