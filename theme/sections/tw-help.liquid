<section class="tw-section tw-help">
  <div class="tw-wrap">
    {% render 'tw-section-head', heading: section.settings.heading, text: section.settings.text, link: section.settings.link, link_label: section.settings.link_label %}
    <ul class="tw-help__grid" role="list">
      {%- for block in section.blocks -%}
        <li>
          <a href="{{ block.settings.link }}" class="tw-help__item">
            {% render 'tw-icon', name: block.settings.icon, size: 22 %}
            <span class="tw-help__title">{{ block.settings.title }}</span>
            <span class="tw-help__text">{{ block.settings.text }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Help links",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help with your order" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "link_label", "label": "Link text" }
  ],
  "blocks": [
    { "type": "item", "name": "Link", "settings": [
      { "type": "text", "id": "icon", "label": "Icon", "default": "help" },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" },
      { "type": "url", "id": "link", "label": "Link" }
    ] }
  ]
}
{% endschema %}
