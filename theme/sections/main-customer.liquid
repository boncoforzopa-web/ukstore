<section class="tw-section tw-account">
  <div class="tw-wrap tw-account__wrap">
    {%- case request.page_type -%}
      {%- when 'customers/login' -%}
        <div class="tw-glass tw-account__card">
          <p class="tw-kicker">Konto</p>
          <h1 class="tw-h2">Anmelden</h1>
          {%- form 'customer_login' -%}
            {%- if form.errors -%}<div class="tw-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="tw-field"><label for="CustomerEmail">E-Mail</label><input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required></div>
            {%- if form.password_needed -%}
              <div class="tw-field"><label for="CustomerPassword">Passwort</label><input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password"></div>
            {%- endif -%}
            <button class="tw-btn tw-btn--gold tw-btn--block" type="submit">Anmelden</button>
          {%- endform -%}
          <p class="tw-small tw-center"><a href="{{ routes.account_register_url }}">Neues Konto erstellen</a></p>
          <details class="tw-acc">
            <summary class="tw-acc__q"><span>Passwort vergessen?</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary>
            <div class="tw-acc__a"><div>
              {%- form 'recover_customer_password' -%}
                {%- if form.errors -%}<div class="tw-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
                {%- if form.posted_successfully? -%}<p class="tw-success" role="status">Falls ein Konto mit dieser E-Mail existiert, haben wir dir einen Link geschickt.</p>{%- endif -%}
                <div class="tw-field"><label for="RecoverEmail">E-Mail</label><input id="RecoverEmail" type="email" name="email" autocomplete="email" required></div>
                <button class="tw-btn tw-btn--glass tw-btn--block" type="submit">Link senden</button>
              {%- endform -%}
            </div></div>
          </details>
        </div>

      {%- when 'customers/register' -%}
        <div class="tw-glass tw-account__card">
          <p class="tw-kicker">Konto</p>
          <h1 class="tw-h2">Konto erstellen</h1>
          {%- form 'create_customer' -%}
            {%- if form.errors -%}<div class="tw-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="tw-field-row">
              <div class="tw-field"><label for="RegisterFirst">Vorname</label><input id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name"></div>
              <div class="tw-field"><label for="RegisterLast">Nachname</label><input id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name"></div>
            </div>
            <div class="tw-field"><label for="RegisterEmail">E-Mail</label><input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required></div>
            <div class="tw-field"><label for="RegisterPassword">Passwort</label><input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
            <p class="tw-small tw-muted">Mit der Registrierung akzeptierst du unsere AGB. Hinweise zur Datenverarbeitung findest du in der {% if settings.privacy_page != blank %}<a href="{{ settings.privacy_page.url }}">Datenschutzerklärung</a>{% else %}Datenschutzerklärung{% endif %}.</p>
            <button class="tw-btn tw-btn--gold tw-btn--block" type="submit">Konto erstellen</button>
          {%- endform -%}
        </div>

      {%- when 'customers/reset_password' -%}
        <div class="tw-glass tw-account__card">
          <h1 class="tw-h2">Neues Passwort wählen</h1>
          {%- form 'reset_customer_password' -%}
            {%- if form.errors -%}<div class="tw-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="tw-field"><label for="ResetPassword">Passwort</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
            <div class="tw-field"><label for="ResetPasswordConfirm">Passwort bestätigen</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
            <button class="tw-btn tw-btn--gold tw-btn--block" type="submit">Speichern</button>
          {%- endform -%}
        </div>

      {%- when 'customers/activate_account' -%}
        <div class="tw-glass tw-account__card">
          <h1 class="tw-h2">Konto aktivieren</h1>
          {%- form 'activate_customer_password' -%}
            {%- if form.errors -%}<div class="tw-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <div class="tw-field"><label for="ActivatePassword">Passwort</label><input id="ActivatePassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
            <div class="tw-field"><label for="ActivatePasswordConfirm">Passwort bestätigen</label><input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
            <button class="tw-btn tw-btn--gold tw-btn--block" type="submit">Aktivieren</button>
          {%- endform -%}
        </div>

      {%- when 'customers/account' -%}
        <div class="tw-head"><div><p class="tw-kicker">Mein Konto</p><h1 class="tw-h1">Hallo {{ customer.first_name | default: customer.name }}</h1></div><a class="tw-link" href="{{ routes.account_logout_url }}">Abmelden {% render 'tw-icon', name: 'arrow-right', size: 16 %}</a></div>
        <div class="tw-account__grid">
          <div class="tw-glass tw-account__card">
            <p class="tw-h3">Bestellungen</p>
            {%- paginate customer.orders by 20 -%}
              {%- if customer.orders.size > 0 -%}
                <ul class="tw-orders" role="list">
                  {%- for order in customer.orders -%}
                    <li><a href="{{ order.customer_url }}"><strong>{{ order.name }}</strong><span class="tw-muted">{{ order.created_at | date: '%d.%m.%Y' }}</span><span>{{ order.financial_status_label }}</span><span>{{ order.fulfillment_status_label }}</span><strong>{{ order.total_price | money_without_currency | strip | append: ' €' }}</strong></a></li>
                  {%- endfor -%}
                </ul>
              {%- else -%}
                <p class="tw-muted">Du hast noch keine Bestellungen.</p>
                <a class="tw-btn tw-btn--gold" href="{{ routes.all_products_collection_url }}">Jetzt stöbern</a>
              {%- endif -%}
            {%- endpaginate -%}
          </div>
          <div class="tw-glass tw-account__card">
            <p class="tw-h3">Kontodaten</p>
            <p>{{ customer.name }}<br>{{ customer.email }}</p>
            {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
            <a class="tw-btn tw-btn--glass" href="{{ routes.account_addresses_url }}">Adressen verwalten ({{ customer.addresses_count }})</a>
          </div>
        </div>

      {%- when 'customers/order' -%}
        <div class="tw-head"><div><p class="tw-kicker"><a href="{{ routes.account_url }}">← Mein Konto</a></p><h1 class="tw-h1">Bestellung {{ order.name }}</h1><p class="tw-muted">{{ order.created_at | date: '%d.%m.%Y, %H:%M' }} Uhr · {{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</p></div></div>
        <div class="tw-account__grid">
          <div class="tw-glass tw-account__card">
            <ul class="tw-orders" role="list">
              {%- for line_item in order.line_items -%}
                <li><span><strong>{{ line_item.title }}</strong> × {{ line_item.quantity }}{% if line_item.fulfillment %}<br><span class="tw-small tw-muted">Versendet {{ line_item.fulfillment.created_at | date: '%d.%m.%Y' }}{% if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}">Sendung verfolgen</a>{% endif %}</span>{% endif %}</span><strong>{{ line_item.final_line_price | money_without_currency | strip | append: ' €' }}</strong></li>
              {%- endfor -%}
            </ul>
            <div class="tw-sumrow"><span>Zwischensumme</span><span>{{ order.line_items_subtotal_price | money_without_currency | strip | append: ' €' }}</span></div>
            {%- for shipping_method in order.shipping_methods -%}<div class="tw-sumrow"><span>Versand ({{ shipping_method.title }})</span><span>{{ shipping_method.price | money_without_currency | strip | append: ' €' }}</span></div>{%- endfor -%}
            {%- for tax_line in order.tax_lines -%}<div class="tw-sumrow tw-small tw-muted"><span>enth. {{ tax_line.title }} {{ tax_line.rate_percentage }}%</span><span>{{ tax_line.price | money_without_currency | strip | append: ' €' }}</span></div>{%- endfor -%}
            <div class="tw-sumrow"><strong>Gesamt</strong><strong>{{ order.total_price | money_without_currency | strip | append: ' €' }}</strong></div>
          </div>
          <div class="tw-glass tw-account__card">
            {%- if order.shipping_address -%}<p class="tw-h3">Lieferadresse</p>{{ order.shipping_address | format_address }}{%- endif -%}
            {%- if order.billing_address -%}<p class="tw-h3">Rechnungsadresse</p>{{ order.billing_address | format_address }}{%- endif -%}
          </div>
        </div>

      {%- when 'customers/addresses' -%}
        <div class="tw-head"><div><p class="tw-kicker"><a href="{{ routes.account_url }}">← Mein Konto</a></p><h1 class="tw-h1">Adressen</h1></div></div>
        {%- paginate customer.addresses by 10 -%}
        <div class="tw-account__grid">
          {%- for address in customer.addresses -%}
            <div class="tw-glass tw-account__card">
              {%- if address == customer.default_address -%}<span class="tw-chip tw-chip--gold tw-chip--sm">Standard</span>{%- endif -%}
              {{ address | format_address }}
              <details class="tw-acc">
                <summary class="tw-acc__q"><span>Bearbeiten</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary>
                <div class="tw-acc__a"><div>
                  {%- form 'customer_address', address -%}
                    {% render 'tw-address-fields', form: form, id: address.id %}
                    <button class="tw-btn tw-btn--gold tw-btn--block" type="submit">Speichern</button>
                  {%- endform -%}
                  <form method="post" action="{{ address.url }}"><input type="hidden" name="_method" value="delete"><button type="submit" class="tw-linkbtn tw-small">Adresse löschen</button></form>
                </div></div>
              </details>
            </div>
          {%- endfor -%}
          <div class="tw-glass tw-account__card">
            <p class="tw-h3">Neue Adresse</p>
            {%- form 'customer_address', customer.new_address -%}
              {% render 'tw-address-fields', form: form, id: 'new' %}
              <button class="tw-btn tw-btn--gold tw-btn--block" type="submit">Adresse hinzufügen</button>
            {%- endform -%}
          </div>
        </div>
        {%- endpaginate -%}
        <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
        <script>
          document.addEventListener('DOMContentLoaded', function () {
            if (!window.Shopify || !Shopify.CountryProvinceSelector) return;
            document.querySelectorAll('[data-country-select]').forEach(function (el) {
              var id = el.getAttribute('data-country-select');
              new Shopify.CountryProvinceSelector('AddressCountry-' + id, 'AddressProvince-' + id, { hideElement: 'AddressProvinceWrap-' + id });
            });
          });
        </script>
    {%- endcase -%}
  </div>
</section>

{% schema %}
{ "name": "Kundenkonto", "settings": [] }
{% endschema %}
