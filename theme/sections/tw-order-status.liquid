{%- assign os = order_status -%}
<section class="tw-section tw-os">
  <div class="tw-wrap tw-os__wrap">
    {%- if os.order -%}
      {%- assign o = os.order -%}
      <div class="tw-head tw-head--center"><div><p class="tw-kicker">Bestellstatus</p><h1 class="tw-h2">Bestellung #{{ o.number }}</h1><p class="tw-muted">Bestellt am {{ o.created | date: '%d.%m.%Y' }} · {{ o.total | money_without_currency | strip | append: ' €' }} · {{ o.paymentLabel }}</p></div></div>
      <div class="tw-os__card tw-glass">
        {%- if o.status == 'refunded' or o.status == 'cancelled' -%}
          <p class="tw-stock tw-stock--out"><span class="tw-stock__dot" aria-hidden="true"></span>{% if o.status == 'refunded' %}Diese Bestellung wurde erstattet.{% else %}Diese Bestellung wurde storniert.{% endif %}</p>
        {%- else -%}
          {%- capture ck -%}{% render 'tw-icon', name: 'check', size: 20 %}{%- endcapture -%}
          <div class="tw-os__status">
            <span class="tw-os__status-ic">{% if o.step >= 3 %}{% render 'tw-icon', name: 'truck', size: 22 %}{% else %}{% render 'tw-icon', name: 'box', size: 22 %}{% endif %}</span>
            <div>{% if o.step >= 3 %}<b>Dein Paket ist unterwegs</b><small>Versendet am {{ o.shippedAt | date: '%d.%m.%Y' }}{% if o.carrier %} mit {{ o.carrier }}{% endif %}</small>{% elsif o.lines[0].preorder %}<b>Vorbestellung bestätigt</b><small>Versand pünktlich zum Erscheinungstermin</small>{% elsif o.step == 2 %}<b>Wir packen dein Paket</b><small>Zahlung erhalten – Versand in der Regel innerhalb von 1–2 Werktagen</small>{% else %}<b>Bestellung eingegangen</b><small>Wir warten auf die Zahlungsbestätigung</small>{% endif %}</div>
          </div>
          <ol class="tw-os__steps" role="list">
            <li class="is-done"><span>{{ ck }}</span><b>Bestellt</b><small>{{ o.created | date: '%d.%m.' }}</small></li>
            <li class="{% if o.step >= 2 %}is-done{% else %}is-current{% endif %}"><span>{% if o.step >= 2 %}{{ ck }}{% else %}2{% endif %}</span><b>Bezahlt</b><small>{% if o.paidAt %}{{ o.paidAt | date: '%d.%m.' }}{% elsif o.step >= 2 %}bestätigt{% else %}ausstehend{% endif %}</small></li>
            <li class="{% if o.step >= 3 %}is-done{% elsif o.step == 2 %}is-current{% endif %}"><span>{% if o.step >= 3 %}{{ ck }}{% else %}{% render 'tw-icon', name: 'box', size: 20 %}{% endif %}</span><b>Versendet</b><small>{% if o.shippedAt %}{{ o.shippedAt | date: '%d.%m.' }}{% elsif o.step == 2 %}in Vorbereitung{% endif %}</small></li>
            <li class="{% if o.step >= 3 %}is-current{% endif %}"><span>{% render 'tw-icon', name: 'truck', size: 20 %}</span><b>Zugestellt</b><small>{% if o.step >= 3 %}in 1–2 Werktagen{% else %}1–2 Werktage nach Versand{% endif %}</small></li>
          </ol>
          {%- if o.tracking -%}
            <div class="tw-os__track"><p>{% render 'tw-icon', name: 'truck', size: 18 %} Unterwegs mit <b>{{ o.carrier }}</b> · Sendungsnummer <code>{{ o.tracking }}</code></p>{% if o.tracking_url %}<a class="tw-btn tw-btn--gold" href="{{ o.tracking_url }}" target="_blank" rel="noopener">Sendung verfolgen</a>{% endif %}</div>
          {%- elsif o.status == 'paid' -%}
            <p class="tw-os__note">{% render 'tw-icon', name: 'mail', size: 18 %} <span>Sobald dein Paket unterwegs ist, bekommst du die <b>Sendungsnummer per E-Mail</b> und kannst es hier live verfolgen.</span></p>
          {%- endif -%}
        {%- endif -%}
      </div>
      <div class="tw-os__grid">
        <div class="tw-os__card tw-glass">
          <p class="tw-kicker">Artikel</p>
          <ul class="tw-co__items" role="list">
            {%- for l in o.lines -%}
              <li class="tw-co__item"><span class="tw-co__thumb">{% if l.image %}<img src="{{ l.image }}" alt="" width="64" height="64" loading="lazy">{% endif %}<b class="tw-co__qty">{{ l.quantity }}</b></span><span class="tw-co__item-body"><a href="/products/{{ l.handle }}" class="tw-co__item-title">{{ l.title }}</a>{% if l.preorder %}<span class="tw-chip tw-chip--gold tw-chip--sm">Vorbestellung{% if l.release %} · {{ l.release }}{% endif %}</span>{% endif %}</span><strong class="tw-co__item-price">{{ l.line_total | money_without_currency | strip | append: ' €' }}</strong></li>
            {%- endfor -%}
          </ul>
          <div class="tw-sumrow tw-co__total"><span>Gesamt</span><strong>{{ o.total | money_without_currency | strip | append: ' €' }}</strong></div>
        </div>
        <div class="tw-os__card tw-glass">
          <p class="tw-kicker">Lieferadresse</p>
          <p class="tw-os__addr">{{ o.shipName | default: o.name }}<br>{{ o.address.line1 }}{% if o.address.line2 != blank %}<br>{{ o.address.line2 }}{% endif %}<br>{{ o.address.postal_code }} {{ o.address.city }}<br>Deutschland</p>
          {%- if o.events.size > 0 -%}<p class="tw-kicker">Verlauf</p><ul class="tw-os__events" role="list">{%- for e in o.events -%}<li><span>{{ e.at | date: '%d.%m.%Y, %H:%M' }}</span>{{ e.text }}</li>{%- endfor -%}</ul>{%- endif -%}
          <p class="tw-small tw-muted">Fragen zur Bestellung? <a href="mailto:{{ settings.contact_email }}?subject=Bestellung%20%23{{ o.number }}">{{ settings.contact_email }}</a></p>
        </div>
      </div>
      <p class="tw-os__again"><a href="/bestellung">Andere Bestellung abrufen</a></p>
    {%- else -%}
      <div class="tw-head tw-head--center"><div><p class="tw-kicker">Sendungsverfolgung</p><h1 class="tw-h2">Wo ist meine Bestellung?</h1><p class="tw-muted">Gib deine Bestellnummer und die E-Mail-Adresse aus der Bestellung ein.</p></div></div>
      <form class="tw-os__form tw-glass" method="post" action="/bestellung">
        {%- if os.error != blank -%}<p class="tw-error" role="alert">{{ os.error }}</p>{%- endif -%}
        <div class="tw-field"><label for="os-nr">Bestellnummer</label><input id="os-nr" name="number" value="{{ os.number }}" placeholder="z. B. 1104" inputmode="numeric" required autocomplete="off"></div>
        <div class="tw-field"><label for="os-email">E-Mail-Adresse</label><input id="os-email" name="email" type="email" value="{{ os.email }}" placeholder="name@beispiel.de" required autocomplete="email"></div>
        <button type="submit" class="tw-btn tw-btn--gold tw-btn--lg tw-btn--block"><span>Status anzeigen</span></button>
        <p class="tw-small tw-muted">Die Bestellnummer findest du in deiner Bestellbestätigung. Keine E-Mail bekommen? Schau in den Spam-Ordner oder schreib uns an <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>.</p>
      </form>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Bestellstatus", "settings": [] }
{% endschema %}
