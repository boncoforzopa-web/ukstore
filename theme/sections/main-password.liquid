<section class="tw-password">
  <div class="tw-glass tw-account__card tw-center">
    {% render 'tw-logo' %}
    <h1 class="tw-h2">Bald geöffnet</h1>
    <p class="tw-muted">{{ settings.tagline }}</p>
    {%- if shop.password_message != blank -%}<div class="tw-rte">{{ shop.password_message }}</div>{%- endif -%}
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<div class="tw-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="tw-field"><label for="Password">Passwort</label><input id="Password" type="password" name="password" autocomplete="current-password"></div>
      <button class="tw-btn tw-btn--gold tw-btn--block" type="submit">Eintreten</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Passwort", "settings": [] }
{% endschema %}
