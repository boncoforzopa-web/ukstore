<section class="tw-section tw-faq">
  <div class="tw-wrap tw-faq__layout">
    <div class="tw-faq__intro">
      {%- assign faq_h1 = false -%}{%- if template.suffix == 'faq' -%}{%- assign faq_h1 = true -%}{%- endif -%}
      {%- if faq_h1 -%}<nav class="tw-crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">{{ page.title }}</span></nav>{%- endif -%}
      {% render 'tw-section-head', heading: section.settings.heading, text: section.settings.text, as_h1: faq_h1 %}
      {%- if section.settings.cta_link != blank -%}<a href="{{ section.settings.cta_link }}" class="tw-btn tw-btn--ghost">{{ section.settings.cta_label }}</a>{%- endif -%}
    </div>
    <div class="tw-accordion">
      {%- assign group = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.group != blank and block.settings.group != group -%}{%- assign group = block.settings.group -%}<h2 class="tw-faq__group">{{ group }}</h2>{%- endif -%}
        <details class="tw-acc">
          <summary class="tw-acc__q"><span>{{ block.settings.question }}</span><span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span></summary>
          <div class="tw-acc__a"><div class="tw-rte">{{ block.settings.answer }}</div></div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  <script type="application/ld+json">
    { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
      {%- for block in section.blocks -%}
        { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ] }
  </script>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help and FAQ" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "cta_label", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "group", "label": "Group heading" },
      { "type": "text", "id": "question", "label": "Question" },
      { "type": "richtext", "id": "answer", "label": "Answer" }
    ] }
  ]
}
{% endschema %}
