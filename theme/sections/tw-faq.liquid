<section class="tw-section tw-faq">
  <div class="tw-wrap tw-faq__layout">
    <div class="tw-faq__intro">
      {%- assign faq_h1 = false -%}{%- if template.name == 'page' -%}{%- assign faq_h1 = true -%}{%- endif -%}{% render 'tw-section-head', kicker: section.settings.kicker, heading: section.settings.heading, text: section.settings.text, as_h1: faq_h1 %}
      {%- if section.settings.cta_link != blank -%}
        <a href="{{ section.settings.cta_link }}" class="tw-btn tw-btn--glass" data-reveal>{% render 'tw-icon', name: 'mail', size: 18 %} {{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
    <div class="tw-accordion" data-accordion>
      {%- for block in section.blocks -%}
        <details class="tw-acc tw-glass" data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="tw-acc__q">
            <span>{{ block.settings.question }}</span>
            <span class="tw-acc__icon" aria-hidden="true">{% render 'tw-icon', name: 'plus', size: 18 %}</span>
          </summary>
          <div class="tw-acc__a"><div class="tw-rte">{{ block.settings.answer }}</div></div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" },
    { "type": "text", "id": "text", "label": "Text", "default": "Alles Wichtige zu Versand, Vorbestellungen, Echtheit und Rückgabe." },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Frage stellen" },
    { "type": "url", "id": "cta_link", "label": "Button-Link" },
    { "type": "checkbox", "id": "open_first", "label": "Erste Frage geöffnet", "default": true }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Wie schnell versendet ihr?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Antwort</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "qa" }] }]
}
{% endschema %}
