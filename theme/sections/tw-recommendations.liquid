<section class="tw-recos" data-recos data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related">
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="tw-section">
      <div class="tw-wrap">
        <div class="tw-head"><div><h2 class="tw-h2">Goes well with</h2></div></div>
        <div class="tw-grid tw-grid--4">
          {%- for product in recommendations.products -%}{% render 'tw-product-card', product: product, index: forloop.index0 %}{%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Related products", "settings": [] }
{% endschema %}
