<article class="tw-section tw-page">
  <div class="tw-wrap tw-page__wrap">
    <nav class="tw-crumbs" aria-label="Brotkrumen"><a href="{{ routes.root_url }}">Start</a><span aria-hidden="true">/</span><a href="{{ blog.url }}">{{ blog.title }}</a></nav>
    <p class="tw-kicker">{{ article.published_at | date: '%d.%m.%Y' }}{% if article.author != blank %} · {{ article.author }}{% endif %}</p>
    <h1 class="tw-h1">{{ article.title }}</h1>
    {%- if article.image -%}<div class="tw-page__img tw-glass">{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', alt: article.title }}</div>{%- endif -%}
    <div class="tw-rte">{{ article.content }}</div>
  </div>
</article>
{% schema %}
{ "name": "Beitrag", "settings": [] }
{% endschema %}
