<section class="tw-section tw-rich{% if section.settings.first %} tw-rich--first{% endif %}">
  <div class="tw-wrap tw-rich__layout{% if section.settings.layout == 'right' %} tw-rich__layout--rev{% endif %}">
    <div class="tw-rich__copy" data-reveal>
      {%- if section.settings.kicker != blank -%}<p class="tw-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      {%- if section.settings.first -%}<h1 class="tw-h1">{{ section.settings.heading }}</h1>{%- else -%}<h2 class="tw-h2">{{ section.settings.heading }}</h2>{%- endif -%}
      <div class="tw-rte tw-muted">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link }}" class="tw-btn tw-btn--gold">{{ section.settings.button_label }} {% render 'tw-icon', name: 'arrow-right', size: 18 %}</a>{%- endif -%}
    </div>
    <div class="tw-rich__media tw-glass" data-reveal style="--i: 1"{% if settings.enable_tilt %} data-tilt{% endif %}>
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 900, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.heading }}
      {%- else -%}
        {% render 'tw-art', type: section.settings.art, hue: section.settings.hue, label: 'Tawa Gold', sub: 'Since 2026', uid: section.id %}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text mit Bild",
  "settings": [
    { "type": "checkbox", "id": "first", "label": "Erste Sektion der Seite (H1)", "default": false },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Über uns" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Von Sammlern für Sammler" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "select", "id": "art", "label": "Platzhalter-Grafik", "default": "etb", "options": [ { "value": "booster", "label": "Display" }, { "value": "etb", "label": "ETB" }, { "value": "tin", "label": "Tin" }, { "value": "pack", "label": "Booster-Pack" } ] },
    { "type": "range", "id": "hue", "label": "Farbton Platzhalter", "min": 0, "max": 360, "step": 5, "default": 40 },
    { "type": "select", "id": "layout", "label": "Bild", "default": "left", "options": [ { "value": "left", "label": "rechts" }, { "value": "right", "label": "links" } ] }
  ],
  "presets": [{ "name": "Text mit Bild" }]
}
{% endschema %}
