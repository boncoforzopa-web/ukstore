{%- paginate search.results by 24 -%}
<section class="tw-section tw-searchpage">
  <div class="tw-wrap">
    <h1 class="tw-h1">{% if search.performed %}{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for “{{ search.terms }}”{% else %}Search{% endif %}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="tw-search tw-search--lg tw-searchpage__form" data-predictive>
      <label for="tw-search-page" class="visually-hidden">Search products</label>
      <span class="tw-search__icon">{% render 'tw-icon', name: 'search', size: 20 %}</span>
      <input id="tw-search-page" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search trees, baubles, lights…" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="tw-predictive-page" aria-expanded="false">
      <input type="hidden" name="type" value="product">
      <div class="tw-predictive" id="tw-predictive-page" data-predictive-results role="listbox" hidden></div>
    </form>
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="tw-grid tw-grid--4">
          {%- for item in search.results -%}{% render 'tw-product-card', product: item, index: forloop.index0, heading_level: 'h2' %}{%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}{% render 'tw-pagination', paginate: paginate %}{%- endif -%}
      {%- else -%}
        <div class="tw-empty tw-empty--plain">
          <div>
            <p class="tw-h3">Nothing matches “{{ search.terms }}”</p>
            <p class="tw-muted">Check the spelling, try a more general word such as “wreath” or “lights”, or browse a category.</p>
            <ul class="tw-chips" role="list">
              {%- for c in collections -%}{%- if c.featured -%}<li><a class="tw-setchip" href="{{ c.url }}">{{ c.title }}</a></li>{%- endif -%}{%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
