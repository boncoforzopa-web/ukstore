{%- paginate blog.articles by 9 -%}
<section class="tw-section">
  <div class="tw-wrap">
    <div class="tw-head"><div><p class="tw-kicker">Magazin</p><h1 class="tw-h1">{{ blog.title }}</h1></div></div>
    <div class="tw-grid tw-grid--3">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="tw-result tw-glass" data-reveal style="--i: {{ forloop.index0 | modulo: 6 }}">
          {%- if article.image -%}<div class="tw-result__media">{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 800', alt: article.title }}</div>{%- endif -%}
          <p class="tw-kicker">{{ article.published_at | date: '%d.%m.%Y' }}</p>
          <h2 class="tw-h3">{{ article.title }}</h2>
          <p class="tw-muted tw-small">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </a>
      {%- else -%}
        <p class="tw-muted">Noch keine Beiträge.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}{% render 'tw-pagination', paginate: paginate %}{%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
