<section class="tw-section tw-cartpage">
  <div class="tw-wrap">
    <h1 class="tw-h1">Your basket</h1>
    {%- if cart.item_count == 0 -%}
      <div class="tw-empty tw-empty--plain">
        <div>
          <p class="tw-h3">Your basket is empty</p>
          <p class="tw-muted">Pick a category to start.</p>
          <ul class="tw-chips" role="list">
            {%- for c in collections -%}{%- if c.featured -%}<li><a class="tw-setchip" href="{{ c.url }}">{{ c.title }}</a></li>{%- endif -%}{%- endfor -%}
          </ul>
        </div>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="tw-cartpage__layout" id="tw-cart-form">
        <ul class="tw-lines tw-lines--page" role="list">
          {%- for item in cart.items -%}
            <li class="tw-line">
              <a href="{{ item.url }}" class="tw-line__media">
                {%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title, widths: '150, 300' }}{%- else -%}{% render 'tw-art', type: item.product.collections.first.art %}{%- endif -%}
              </a>
              <div class="tw-line__info">
                <a href="{{ item.url }}" class="tw-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="tw-muted tw-small">{{ item.variant.title }}</p>{%- endunless -%}
                {%- if item.product.tags contains 'Pre-order' -%}<p class="tw-small tw-line__pre">Pre-order: sent when it arrives with us</p>{%- endif -%}
                <p class="tw-small tw-muted">{{ item.final_price | money }} each</p>
                <div class="tw-line__row">
                  <div class="tw-qty" data-qty>
                    <button type="button" data-qty-minus aria-label="Decrease quantity">{% render 'tw-icon', name: 'minus', size: 16 %}</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" max="99" inputmode="numeric" aria-label="Quantity of {{ item.product.title | escape }}">
                    <button type="button" data-qty-plus aria-label="Increase quantity">{% render 'tw-icon', name: 'plus', size: 16 %}</button>
                  </div>
                  <div class="tw-line__price"><strong>{{ item.final_line_price | money }}</strong></div>
                </div>
                <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="tw-linkbtn tw-small">Remove<span class="visually-hidden"> {{ item.product.title | escape }}</span></a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <aside class="tw-summary">
          <h2 class="tw-h3">Order summary</h2>
          <div class="tw-sumrow"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
          <div class="tw-sumrow tw-small tw-muted"><span>Delivery</span><span>{% if shop.ship_fee > 0 %}Calculated at checkout{% else %}Free{% endif %}</span></div>
          <p class="tw-muted tw-small">{% if settings.tax_note != blank %}{{ settings.tax_note }}. {% endif %}{% if settings.shipping_page != blank %}<a href="{{ settings.shipping_page.url }}">Delivery details</a>{% endif %}</p>
          <div class="tw-field">
            <label for="CartNote">Note for your order (optional)</label>
            <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
          <button type="submit" name="update" class="tw-btn tw-btn--ghost tw-btn--block">Update basket</button>
          {%- if cart.total_price < min_order -%}
            <p class="tw-note">The minimum order is {{ min_order | money }}. Add {{ min_order | minus: cart.total_price | money }} more to check out.</p>
          {%- else -%}
            <button type="submit" name="checkout" class="tw-btn tw-btn--gold tw-btn--lg tw-btn--block">{% render 'tw-icon', name: 'lock', size: 18 %} Checkout</button>
          {%- endif -%}
          <a href="{{ routes.collections_url }}" class="tw-link">Continue shopping</a>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Basket", "settings": [] }
{% endschema %}
