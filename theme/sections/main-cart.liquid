<section class="tw-section tw-cartpage">
  <div class="tw-wrap">
    <div class="tw-head"><div><p class="tw-kicker">Warenkorb</p><h1 class="tw-h1">Dein Warenkorb</h1></div></div>
    {%- if cart.item_count == 0 -%}
      <div class="tw-empty tw-glass">
        <p class="tw-h3">Dein Warenkorb ist leer</p>
        <p class="tw-muted">Zeit für dein nächstes Sealed-Highlight.</p>
        <a class="tw-btn tw-btn--gold" href="{{ routes.all_products_collection_url }}">Weiter einkaufen {% render 'tw-icon', name: 'arrow-right', size: 18 %}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="tw-cartpage__layout" id="tw-cart-form">
        <ul class="tw-lines tw-lines--page" role="list">
          {%- for item in cart.items -%}
            <li class="tw-line tw-glass">
              <a href="{{ item.url }}" class="tw-line__media">
                {%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title, widths: '150, 300' }}{%- else -%}{%- assign lu = 'cpl' | append: forloop.index -%}{% render 'tw-art', type: 'booster', hue: 265, label: item.product.type, sub: '', uid: lu %}{%- endif -%}
              </a>
              <div class="tw-line__info">
                <a href="{{ item.url }}" class="tw-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="tw-muted tw-small">{{ item.variant.title }}</p>{%- endunless -%}
                {%- if item.product.tags contains 'Pre-order' -%}<span class="tw-chip tw-chip--gold tw-chip--sm">Vorbestellung – Versand zum Erscheinen</span>{%- endif -%}
                <p class="tw-small tw-muted">Einzelpreis {{ item.final_price | money_without_currency | strip | append: ' €' }}</p>
                <div class="tw-line__row">
                  <div class="tw-qty" data-qty>
                    <button type="button" data-qty-minus aria-label="Menge verringern">{% render 'tw-icon', name: 'minus', size: 16 %}</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" max="10" inputmode="numeric" aria-label="Menge für {{ item.product.title | escape }}">
                    <button type="button" data-qty-plus aria-label="Menge erhöhen">{% render 'tw-icon', name: 'plus', size: 16 %}</button>
                  </div>
                  <div class="tw-line__price">
                    {%- if item.original_line_price > item.final_line_price -%}<s class="tw-muted tw-small">{{ item.original_line_price | money_without_currency | strip | append: ' €' }}</s>{%- endif -%}
                    <strong>{{ item.final_line_price | money_without_currency | strip | append: ' €' }}</strong>
                  </div>
                </div>
                <a href="{{ item.url_to_remove }}" class="tw-linkbtn tw-small">Entfernen</a>
              </div>
            </li>
          {%- endfor -%}
          {% render 'tw-gift', g: cart.gift, mode: 'line', page_line: true %}
        </ul>
        <aside class="tw-summary tw-glass">
          <p class="tw-h3">Zusammenfassung</p>
          {% render 'tw-gift', g: cart.gift, mode: 'bar' %}
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="tw-sumrow tw-small"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money_without_currency | strip | append: ' €' }}</span></div>
          {%- endfor -%}
          <div class="tw-sumrow"><span>Zwischensumme</span><strong>{{ cart.total_price | money_without_currency | strip | append: ' €' }}</strong></div>
          <p class="tw-muted tw-small">{% if cart.taxes_included %}inkl. MwSt.{% else %}zzgl. MwSt.{% endif %}, Versand in DE kostenlos, in andere EU-Länder 14,90 € (ab 200 € kostenlos).{% if settings.shipping_page != blank %} <a href="{{ settings.shipping_page.url }}">Versand &amp; Zahlung</a>{% endif %}</p>
          <div class="tw-field">
            <label for="CartNote">Anmerkung zur Bestellung</label>
            <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
          <button type="submit" name="update" class="tw-btn tw-btn--ghost tw-btn--block">Warenkorb aktualisieren</button>
          {%- if cart.total_price < min_order -%}
          {%- assign min_missing = min_order | minus: cart.total_price -%}
          <div class="tw-minorder"><p class="tw-small">Mindestbestellwert <strong>{{ min_order | money_without_currency | strip | append: ' €' }}</strong> – es fehlen noch <strong>{{ min_missing | money_without_currency | strip | append: ' €' }}</strong>.</p><a href="/collections/all" class="tw-btn tw-btn--gold tw-btn--block">Weiter einkaufen</a></div>
          {%- else -%}
          <button type="submit" name="checkout" class="tw-btn tw-btn--gold tw-btn--lg tw-btn--block tw-btn--shimmer">{% render 'tw-icon', name: 'lock', size: 18 %} Zur Kasse</button>
          {%- endif -%}
          {%- if additional_checkout_buttons -%}<div class="tw-addl">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
          <ul class="tw-pdp__trust" role="list">
            <li>{% render 'tw-icon', name: 'lock', size: 18 %}<span>Sicherer Checkout</span></li>
            <li>{% render 'tw-icon', name: 'return', size: 18 %}<span>14 Tage Widerrufsrecht</span></li>
          </ul>
        </aside>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Warenkorb", "settings": [], "enabled_on": { "templates": ["cart"] } }
{% endschema %}
