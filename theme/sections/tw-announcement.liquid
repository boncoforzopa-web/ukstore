{%- comment -%}
  One or more short messages. Each block can carry a link and a start/end date (YYYY-MM-DD);
  a message outside its dates is not rendered, so an expired offer can never stay on the site.
{%- endcomment -%}
{%- comment -%}
  [[SLEEPS]] in a message becomes "37 sleeps" (nights until 25 December, shop time). A message that uses it
  is only shown in the run-up to Christmas (1 to 99 sleeps), so it never needs switching off by hand.
{%- endcomment -%}
{%- liquid
  assign today = 'now' | date: '%Y-%m-%d'
  assign now_s = 'now' | date: '%s' | plus: 0
  assign xmas_s = 'now' | date: '%Y' | append: '-12-25' | date: '%s' | plus: 0
  assign sleeps = xmas_s | minus: now_s | divided_by: 86400.0 | ceil
  if sleeps == 1
    assign sleeps_text = '1 sleep'
  else
    assign sleeps_text = sleeps | append: ' sleeps'
  endif
-%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.text == blank -%}{%- continue -%}{%- endif -%}
    {%- if block.settings.starts != blank and block.settings.starts > today -%}{%- continue -%}{%- endif -%}
    {%- if block.settings.ends != blank and block.settings.ends < today -%}{%- continue -%}{%- endif -%}
    {%- assign msg = block.settings.text -%}
    {%- assign festive = false -%}
    {%- if msg contains '[[SLEEPS]]' -%}
      {%- if sleeps < 1 or sleeps > 99 -%}{%- continue -%}{%- endif -%}
      {%- assign msg = msg | replace: '[[SLEEPS]]', sleeps_text -%}
      {%- assign festive = true -%}
    {%- endif -%}
    <li class="tw-announce__item{% if festive %} tw-announce__item--festive{% endif %}">
      {%- if festive -%}<svg class="tw-announce__star" viewBox="0 0 12 12" width="11" height="11" aria-hidden="true" focusable="false"><path d="M6 0l1.500 4.500L12 6 7.500 7.500 6 12 4.500 7.500 0 6l4.500-1.500Z" fill="currentColor"/></svg>{%- endif -%}
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ msg }}{% if block.settings.link_label != blank %} <u>{{ block.settings.link_label }}</u>{% endif %}</a>{%- else -%}<span>{{ msg }}</span>{%- endif -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}
{%- if items != blank -%}
<div class="tw-announce" role="region" aria-label="Shop notices">
  <ul class="tw-wrap tw-announce__list" role="list" data-announce>{{ items }}</ul>
</div>
<script>
  (function () {
    var list = document.querySelector('[data-announce]'); if (!list) return;
    var items = list.children; if (items.length < 2) { if (items[0]) items[0].classList.add('is-active'); return; }
    var i = 0; items[0].classList.add('is-active'); list.classList.add('is-rotating');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    setInterval(function () { if (document.hidden || list.matches(':hover, :focus-within')) return; items[i].classList.remove('is-active'); i = (i + 1) % items.length; items[i].classList.add('is-active'); }, 5000);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "blocks": [
    { "type": "message", "name": "Message", "settings": [
      { "type": "text", "id": "text", "label": "Text", "info": "[[SLEEPS]] becomes the number of sleeps until Christmas, for example: [[SLEEPS]] until Christmas." },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "text", "id": "link_label", "label": "Link text" },
      { "type": "text", "id": "starts", "label": "Show from (YYYY-MM-DD)" },
      { "type": "text", "id": "ends", "label": "Show until (YYYY-MM-DD)" }
    ] }
  ]
}
{% endschema %}
