<section class="tw-section tw-wishlist">
  <div class="tw-wrap">
    <h1 class="tw-h1">{{ page.title | default: 'Saved items' }}</h1>
    <p class="tw-muted">Saved in this browser. No account needed.</p>
    <div class="tw-grid tw-grid--4" data-wishlist-grid></div>
    <div class="tw-empty tw-empty--plain" data-wishlist-empty hidden>
      <div>
        <p class="tw-h3">You have not saved anything yet</p>
        <p class="tw-muted">Tap the heart on any product to keep it here.</p>
        <a href="{{ routes.collections_url }}" class="tw-btn tw-btn--gold">Browse categories</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Saved items", "settings": [] }
{% endschema %}
