<section class="tw-section tw-catlist">
  <div class="tw-wrap">
    <nav class="tw-crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span><span aria-current="page">Categories</span></nav>
    <h1 class="tw-h1">Shop by category</h1>
    <ul class="tw-catlist__grid" role="list">
      {%- for c in collections -%}
        {%- if c.parent -%}{%- continue -%}{%- endif -%}
        <li class="tw-catlist__item">
          <a href="{{ c.url }}" class="tw-catlist__media"><span class="tw-arch">{%- if c.image -%}{{ c.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{%- else -%}{% render 'tw-art', type: c.art %}{%- endif -%}</span></a>
          <div>
            <h2 class="tw-h3"><a href="{{ c.url }}">{{ c.title }}</a></h2>
            {%- if c.children.size > 0 -%}
              <ul role="list" class="tw-catlist__links">
                {%- for child in c.children -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
              </ul>
            {%- else -%}
              <div class="tw-muted tw-small">{{ c.description }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Category list", "settings": [] }
{% endschema %}
