<section class="tw-section">
  <div class="tw-wrap">
    <div class="tw-head"><div><p class="tw-kicker">Shop</p><h1 class="tw-h1">Alle Kategorien</h1></div></div>
    <div class="tw-grid tw-grid--3">
      {%- for collection in collections -%}
        {%- unless collection.handle == 'frontpage' or collection.products_count == 0 -%}
        <a href="{{ collection.url }}" class="tw-bento__tile tw-glass tw-collcard" data-reveal style="--i: {{ forloop.index0 | modulo: 6 }}">
          <div class="tw-bento__media">
            {%- liquid
              assign pimg = blank
              if collection.image == blank
                for p in collection.products
                  if p.featured_image
                    assign pimg = p.featured_image
                    break
                  endif
                endfor
              endif
            -%}
            {%- if collection.image -%}{{ collection.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', alt: collection.title }}
            {%- elsif pimg != blank -%}{{ pimg | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 700', sizes: '(min-width: 990px) 30vw, 60vw', alt: collection.title, class: 'tw-bento__product' }}
            {%- else -%}{%- assign chue = collection.id | modulo: 360 -%}{% render 'tw-art', type: 'booster', hue: chue, label: collection.title, sub: 'Tawa Gold', uid: collection.id %}{%- endif -%}
          </div>
          <div class="tw-bento__copy"><p class="tw-kicker">Kollektion</p><h2 class="tw-bento__title">{{ collection.title }}</h2></div>
          <span class="tw-bento__arrow">{% render 'tw-icon', name: 'arrow-up-right', size: 22 %}</span>
        </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Kollektionsliste", "settings": [] }
{% endschema %}
