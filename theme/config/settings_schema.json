[
  { "name": "theme_info", "theme_name": "The Christmas Sweet Shop", "theme_version": "1.0.0", "theme_author": "", "theme_documentation_url": "", "theme_support_url": "" },
  { "name": "Brand", "settings": [
    { "type": "text", "id": "brand_name", "label": "Shop name", "default": "The Christmas Sweet Shop" },
    { "type": "checkbox", "id": "show_vendor_on_cards", "label": "Show the brand name above product names in product grids", "default": false },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Christmas trees, decorations and lights" },
    { "type": "image_picker", "id": "logo", "label": "Logo image (replaces the drawn logo)" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 80, "max": 260, "step": 5, "default": 170 },
    { "type": "image_picker", "id": "favicon", "label": "Favicon" }
  ] },
  { "name": "Shop-wide sale", "settings": [
    { "type": "paragraph", "content": "Takes a percentage off every price between two dates and shows the price before the sale as the was-price. Set the percentage to 0 to switch it off." },
    { "type": "text", "id": "sale_name", "label": "Name of the sale", "default": "Sale" },
    { "type": "range", "id": "sale_percent", "label": "Percentage off every price", "min": 0, "max": 90, "step": 1, "default": 0 },
    { "type": "text", "id": "sale_starts", "label": "First day (YYYY-MM-DD)" },
    { "type": "text", "id": "sale_ends", "label": "Last day (YYYY-MM-DD), ends at midnight UK time" }
  ] },
  { "name": "Colours", "settings": [
    { "type": "color", "id": "color_pine", "label": "Primary (dark background, buttons)", "default": "#141110" },
    { "type": "color", "id": "color_ivory", "label": "Secondary (ivory)", "default": "#F7F2E8" },
    { "type": "color", "id": "color_gold", "label": "Accent (gold)", "default": "#B8975A" },
    { "type": "color", "id": "color_cranberry", "label": "Sale accent (cranberry)", "default": "#9B1C31" }
  ] },
  { "name": "Shop behaviour", "settings": [
    { "type": "range", "id": "low_stock_threshold", "label": "Show 'only a few left' at or below (0 = never)", "min": 0, "max": 20, "step": 1, "default": 0 },
    { "type": "text", "id": "delivery_note", "label": "Delivery note on product pages" },
    { "type": "text", "id": "tax_note", "label": "Tax note next to prices (for example: Includes VAT)" },
    { "type": "page", "id": "shipping_page", "label": "Delivery page" },
    { "type": "page", "id": "preorder_page", "label": "Pre-order page" },
    { "type": "page", "id": "returns_page", "label": "Returns page" },
    { "type": "page", "id": "privacy_page", "label": "Privacy page" },
    { "type": "page", "id": "terms_page", "label": "Terms page" },
    { "type": "range", "id": "free_shipping_threshold", "label": "Free delivery from (£, 0 = no threshold)", "min": 0, "max": 500, "step": 5, "default": 0 },
    { "type": "number", "id": "delivery_fee_pence", "label": "Delivery charge in pence", "default": 0 },
    { "type": "checkbox", "id": "enable_wishlist", "label": "Saved items (wishlist)", "default": true },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Quick add on product cards", "default": true },
    { "type": "checkbox", "id": "cookie_banner", "label": "Cookie banner", "default": true }
  ] },
  { "name": "Company details", "settings": [
    { "type": "text", "id": "legal_name", "label": "Registered company name" },
    { "type": "textarea", "id": "business_address", "label": "Business address" },
    { "type": "text", "id": "contact_email", "label": "Contact email" },
    { "type": "text", "id": "contact_phone", "label": "Phone" },
    { "type": "text", "id": "opening_hours", "label": "Customer service hours" },
    { "type": "text", "id": "company_number", "label": "Company number" },
    { "type": "text", "id": "vat_number", "label": "VAT number" },
    { "type": "textarea", "id": "returns_address", "label": "Returns address" }
  ] },
  { "name": "Social media", "settings": [
    { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
    { "type": "text", "id": "social_pinterest", "label": "Pinterest URL" },
    { "type": "text", "id": "social_tiktok", "label": "TikTok URL" }
  ] }
