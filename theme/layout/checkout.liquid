<!doctype html>
<html class="no-js" lang="en-GB" data-mode="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="{{ settings.color_pine | default: '#101B2E' }}">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">{%- endif -%}
    <link rel="preload" href="{{ 'caslon-display.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'instrument-sans.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <title>{{ page_title | escape }} – {{ settings.brand_name | escape }}</title>
    {% render 'css-variables' %}
    {{ content_for_header }}
    {{ 'store.css' | asset_url | stylesheet_tag }}
    <script src="https://js.stripe.com/v3/"></script>
    <script src="{{ 'tw-extras.js' | asset_url }}" defer></script>
    <script src="{{ 'tw-checkout.js' | asset_url }}" defer></script>
  </head>
  <body class="tw-body template-checkout">
    <header class="tw-co-head">
      <div class="tw-wrap tw-co-head__inner">
        <a href="{{ routes.cart_url }}" class="tw-co-head__back">{% render 'tw-icon', name: 'arrow-left', size: 18 %}<span>Basket</span></a>
        {% render 'tw-logo' %}
        <span class="tw-co-head__secure">{% render 'tw-icon', name: 'lock', size: 16 %}<span>Secure checkout</span></span>
      </div>
    </header>
    <main id="MainContent" class="tw-main tw-co-main" role="main">
      {{ content_for_layout }}
    </main>
    <footer class="tw-co-foot">
      <div class="tw-wrap tw-co-foot__inner">
        <nav class="tw-co-foot__links" aria-label="Policies">
          <a href="/pages/terms">Terms of service</a><a href="/pages/returns">Returns and refunds</a><a href="/pages/delivery">Delivery</a><a href="/pages/privacy">Privacy policy</a><a href="/pages/contact">Contact us</a>
        </nav>
        <p class="tw-small tw-muted">© {{ 'now' | date: '%Y' }} {{ settings.legal_name | default: settings.brand_name }}. Prices in pounds sterling (GBP).</p>
      </div>
    </footer>
    <div class="tw-toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
