<!doctype html>
<html class="no-js" lang="de" data-mode="{{ settings.default_mode | default: 'light' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="robots" content="noindex,nofollow">
    <meta name="theme-color" content="#FFFFFF">
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    <link rel="preload" href="{{ 'bricolage-grotesque-latin-wght-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'manrope-latin-wght-normal.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <script>
      (function () {
        var d = document.documentElement;
        d.className = d.className.replace('no-js', 'js');
        try { var m = localStorage.getItem('tw-mode'); try { m = JSON.parse(m); } catch (e2) {} if (m === 'light' || m === 'dark') d.setAttribute('data-mode', m); } catch (e) {}
      })();
    </script>
    <title>{{ page_title }} – {{ settings.brand_name }}</title>
    {% render 'css-variables' %}
    {{ content_for_header }}
    {{ 'tw.css' | asset_url | stylesheet_tag }}
    <script src="https://js.stripe.com/v3/"></script>
    <script src="{{ 'tw-extras.js' | asset_url }}" defer></script>
    <script src="{{ 'tw-checkout.js' | asset_url }}" defer></script>
  </head>
  <body class="tw-body template-checkout">
    {%- if settings.noise_overlay -%}<div class="tw-noise" aria-hidden="true"></div>{%- endif -%}
    <header class="tw-co-head">
      <div class="tw-wrap tw-co-head__inner">
        <a href="{{ routes.cart_url }}" class="tw-co-head__back">{% render 'tw-icon', name: 'arrow-left', size: 18 %}<span>Warenkorb</span></a>
        {% render 'tw-logo' %}
        <span class="tw-chip tw-co-head__secure">{% render 'tw-icon', name: 'lock', size: 14 %} Sicherer Checkout</span>
      </div>
    </header>
    <main id="MainContent" class="tw-main tw-co-main" role="main">
      {{ content_for_layout }}
    </main>
    <footer class="tw-co-foot">
      <div class="tw-wrap tw-co-foot__inner">
        <ul class="tw-payicons tw-co-foot__pay" role="list">
          {%- assign pays = 'visa,master,american_express,apple_pay,google_pay,klarna' | split: ',' -%}
          {%- for type in pays -%}<li>{{ type | payment_type_svg_tag: class: 'tw-payicon' }}</li>{%- endfor -%}
        </ul>
        <nav class="tw-co-foot__links" aria-label="Rechtliches">
          <a href="/pages/agb">AGB</a><a href="/pages/widerrufsbelehrung">Widerrufsbelehrung</a><a href="/pages/datenschutz">Datenschutz</a><a href="/pages/impressum">Impressum</a><a href="/pages/versand-zahlung">Versand &amp; Zahlung</a>
        </nav>
        <p class="tw-small tw-muted">© {{ 'now' | date: '%Y' }} {{ settings.brand_name }} · Alle Preise in EUR inkl. MwSt. · Versand aus Deutschland in die ganze EU, innerhalb Deutschlands kostenlos.</p>
      </div>
    </footer>
    <div class="tw-toast" role="status" aria-live="polite" data-toast></div>
  </body>
</html>
