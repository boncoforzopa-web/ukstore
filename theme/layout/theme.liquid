<!doctype html>
<html class="no-js" lang="en-GB" data-mode="light">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_pine | default: '#17362B' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M4 32V15a12 12 0 0 1 24 0v17Z' fill='%2317362B'/%3E%3Cpath d='M16 8l5 7h-3l4 6h-4l4 6H10l4-6h-4l4-6h-3Z' fill='%23D9C08A'/%3E%3C/svg%3E">
    {%- endif -%}

    <link rel="preload" href="{{ 'caslon-display.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'instrument-sans.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

    {%- capture document_title -%}
      {%- if request.page_type == 'index' -%}
        {{ settings.brand_name }} | {{ settings.tagline }}
      {%- elsif request.page_type == 'search' -%}
        {%- if search.terms != blank -%}Search: {{ search.terms }}{%- else -%}Search{%- endif %} – {{ settings.brand_name }}
      {%- else -%}
        {{ page_title }}{% if current_page != 1 %} – page {{ current_page }}{% endif %}{% unless page_title contains settings.brand_name %} – {{ settings.brand_name }}{% endunless %}
      {%- endif -%}
    {%- endcapture -%}
    <title>{{ document_title | strip | strip_newlines | escape }}</title>

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {{ content_for_header }}

    {{ 'store.css' | asset_url | stylesheet_tag: preload: true }}
    <script src="{{ 'tw.js' | asset_url }}" defer></script>
    <script src="{{ 'tw-extras.js' | asset_url }}" defer></script>

    <script>
      window.TW = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          search: {{ routes.search_url | json }},
          predictive: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        moneyFormat: '£{% raw %}{{amount}}{% endraw %}',
        lowStock: {{ settings.low_stock_threshold | default: 0 }},
        strings: {
          added: "Added to your basket",
          error: "That did not work. Please try again.",
          soldOut: "Out of stock",
          addToCart: "Add to basket",
          preorder: "Pre-order",
          wishlistAdd: "Saved",
          wishlistRemove: "Removed from saved items",
          released: "Available now",
          noResults: "No matches. Try a different word, or browse by category."
        }
      };
    </script>
  </head>

  <body class="tw-body template-{{ request.page_type | handle }}{% if template.suffix %} template-{{ template.suffix | handle }}{% endif %}">
    <a class="tw-skip" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="tw-main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'tw-cart-drawer' %}
    {% render 'tw-search-overlay' %}
    {%- if settings.cookie_banner -%}{% render 'tw-cookie-banner' %}{%- endif -%}

    <div class="tw-toast" role="status" aria-live="polite" data-toast></div>

    {% render 'structured-data' %}
  </body>
</html>
