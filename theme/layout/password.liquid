<!doctype html>
<html lang="de" data-mode="{{ settings.default_mode | default: 'light' }}" class="js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ settings.brand_name }} – {{ settings.tagline }}</title>
    {% render 'css-variables' %}
    {{ content_for_header }}
    {{ 'tw.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="tw-body template-password">
    <div class="tw-noise" aria-hidden="true"></div>
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
  </body>
</html>
