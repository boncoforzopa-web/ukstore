<div class="tw-cookie" data-cookie-banner role="dialog" aria-modal="false" aria-labelledby="tw-cookie-title" aria-describedby="tw-cookie-text" hidden>
  <div class="tw-cookie__card tw-glass">
    <p class="tw-cookie__title" id="tw-cookie-title">{% render 'tw-icon', name: 'shield', size: 20 %} {{ settings.cookie_title }}</p>
    <p class="tw-small tw-muted" id="tw-cookie-text">
      {{ settings.cookie_text }}
      {%- if settings.privacy_page != blank %} <a href="{{ settings.privacy_page.url }}">Datenschutzerklärung</a>{% endif -%}
      {%- if settings.imprint_page != blank %} · <a href="{{ settings.imprint_page.url }}">Impressum</a>{% endif -%}
    </p>
    <div class="tw-cookie__prefs" data-cookie-prefs hidden>
      <label class="tw-switch"><input type="checkbox" checked disabled><span></span><b>Notwendig</b><small>Warenkorb, Checkout, Sicherheit – immer aktiv.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="preferences"><span></span><b>Präferenzen</b><small>Merkt sich z. B. Sprache und Darstellung.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="analytics"><span></span><b>Statistik</b><small>Anonyme Auswertung, wie der Shop genutzt wird.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="marketing"><span></span><b>Marketing</b><small>Personalisierte Werbung auf anderen Plattformen.</small></label>
    </div>
    <div class="tw-cookie__actions">
      <button type="button" class="tw-btn tw-btn--gold tw-btn--sm" data-cookie-necessary>Nur notwendige</button>
      <button type="button" class="tw-btn tw-btn--ghost tw-btn--sm" data-cookie-settings aria-expanded="false">Einstellungen</button>
      <button type="button" class="tw-btn tw-btn--glass tw-btn--sm" data-cookie-save hidden>Auswahl speichern</button>
      <button type="button" class="tw-btn tw-btn--gold tw-btn--sm" data-cookie-all>Alle akzeptieren</button>
    </div>
  </div>
</div>
