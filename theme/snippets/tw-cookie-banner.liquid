<div class="tw-cookie" data-cookie-banner role="dialog" aria-modal="false" aria-labelledby="tw-cookie-title" aria-describedby="tw-cookie-text" hidden>
  <div class="tw-cookie__card">
    <p class="tw-cookie__title" id="tw-cookie-title">Cookies</p>
    <p class="tw-small tw-muted" id="tw-cookie-text">
      We use essential cookies to run the basket and checkout. With your permission we also use cookies to measure how the shop is used and to show relevant adverts.
      {%- if settings.privacy_page != blank %} <a href="{{ settings.privacy_page.url }}">Privacy policy</a>{% endif -%}
    </p>
    <div class="tw-cookie__prefs" data-cookie-prefs hidden>
      <label class="tw-switch"><input type="checkbox" checked disabled><span></span><b>Essential</b><small>Basket, checkout and security. Always on.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="preferences"><span></span><b>Preferences</b><small>Remembers choices such as recently viewed items.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="analytics"><span></span><b>Analytics</b><small>Anonymous statistics on how the shop is used.</small></label>
      <label class="tw-switch"><input type="checkbox" data-consent="marketing"><span></span><b>Marketing</b><small>Personalised adverts on other sites.</small></label>
    </div>
    <div class="tw-cookie__actions">
      <button type="button" class="tw-btn tw-btn--ghost tw-btn--sm" data-cookie-necessary>Essential only</button>
      <button type="button" class="tw-btn tw-btn--ghost tw-btn--sm" data-cookie-settings aria-expanded="false">Choose</button>
      <button type="button" class="tw-btn tw-btn--ghost tw-btn--sm" data-cookie-save hidden>Save choices</button>
      <button type="button" class="tw-btn tw-btn--gold tw-btn--sm" data-cookie-all>Accept all</button>
    </div>
  </div>
</div>
