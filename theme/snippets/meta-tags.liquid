{%- liquid
  assign meta_description = page_description
  if meta_description == blank and request.page_type == 'index'
    assign meta_description = settings.brand_name | append: ': artificial Christmas trees, tree decorations, wreaths and garlands, Christmas lighting and oversized displays, delivered across the UK.'
  elsif meta_description == blank and request.page_type == 'product'
    assign meta_description = product.description | strip_html | truncate: 160
  endif
  assign noindex = false
  if request.page_type == 'cart' or request.page_type == 'search' or request.page_type == '404'
    assign noindex = true
  endif
  if request.page_type == 'collection'
    if collection.all_products_count == 0 or request.__url contains 'filter.' or request.__url contains 'sort_by='
      assign noindex = true
    endif
  endif
  if page.handle == 'wishlist' or page.handle == 'order-tracking'
    assign noindex = true
  endif
-%}
{%- if meta_description != blank -%}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif -%}
{%- if noindex -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}
<meta property="og:site_name" content="{{ settings.brand_name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
<meta property="og:locale" content="en_GB">
{%- if meta_description != blank -%}
  <meta property="og:description" content="{{ meta_description | escape }}">
{%- endif -%}
{%- if page_image -%}
  <meta property="og:image" content="{{ request.origin }}{{ page_image | image_url: width: 1200 }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
{%- if meta_description != blank -%}
  <meta name="twitter:description" content="{{ meta_description | escape }}">
{%- endif -%}
