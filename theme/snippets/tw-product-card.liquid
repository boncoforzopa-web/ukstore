{%- comment -%} Params: product, index, heading_level ('h3') {%- endcomment -%}
{%- liquid
  assign hl = heading_level | default: 'h3'
  assign v = product.selected_or_first_available_variant
  assign is_pre = false
  if product.tags contains 'Pre-order'
    assign is_pre = true
  endif
  assign low = false
  if settings.low_stock_threshold > 0 and v.inventory_management == 'shopify' and v.inventory_quantity > 0 and v.inventory_quantity <= settings.low_stock_threshold
    assign low = true
  endif
-%}
<article class="tw-card">
  <div class="tw-card__media">
    <div class="tw-card__media-inner tw-skeleton">
      {%- if product.featured_media -%}
        {%- assign card_alt = product.featured_media.alt | default: product.title -%}
        {{ product.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 1100px) 300px, (min-width: 750px) 33vw, 50vw', alt: card_alt, class: 'tw-card__img' }}
        {%- if product.media[1] and product.media[1].media_type == 'image' -%}
          {{ product.media[1] | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 1100px) 300px, 50vw', alt: '', class: 'tw-card__img tw-card__img--alt' }}
        {%- endif -%}
      {%- else -%}
        {%- assign card_art = product.collections.first.art | default: 'tree' -%}
        {% render 'tw-art', type: card_art %}
      {%- endif -%}
    </div>
    <span class="tw-card__cane" aria-hidden="true"></span>

    <div class="tw-card__badges">
      {%- if product.compare_at_price > product.price -%}<span class="tw-chip tw-chip--alert">{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}% off</span>{%- elsif product.on_sale -%}<span class="tw-chip tw-chip--alert">Sale</span>{%- endif -%}
      {%- if is_pre -%}<span class="tw-chip tw-chip--gold">Pre-order</span>{%- endif -%}
      {%- if product.tags contains 'New' and is_pre == false -%}<span class="tw-chip">New</span>{%- endif -%}
      {%- if product.available == false -%}<span class="tw-chip tw-chip--muted">Out of stock</span>{%- endif -%}
    </div>

    {%- if settings.enable_wishlist -%}
      <button type="button" class="tw-wish" data-wishlist="{{ product.handle }}" aria-pressed="false" aria-label="Save {{ product.title | escape }}">
        {% render 'tw-icon', name: 'heart', size: 18 %}
      </button>
    {%- endif -%}

    {%- if settings.enable_quick_add and product.available -%}
      {%- if product.has_only_default_variant -%}
        <button type="button" class="tw-quick" data-quick-add="{{ v.id }}">{% if is_pre %}Pre-order{% else %}Add to basket{% endif %}<span class="visually-hidden">: {{ product.title | escape }}</span></button>
      {%- else -%}
        <a class="tw-quick" href="{{ product.url }}">Choose options<span class="visually-hidden">: {{ product.title | escape }}</span></a>
      {%- endif -%}
    {%- endif -%}
  </div>

  <div class="tw-card__body">
    {%- if settings.show_vendor_on_cards and product.vendor != blank and product.vendor != settings.brand_name -%}<p class="tw-card__set">{{ product.vendor }}</p>{%- endif -%}
    <{{ hl }} class="tw-card__title"><a href="{{ product.url }}" class="tw-card__link">{{ product.title }}</a></{{ hl }}>
    {% render 'tw-price', product: product %}
    {%- if is_pre or low or product.available == false -%}
      <p class="tw-stock{% if is_pre %} tw-stock--pre{% elsif product.available == false %} tw-stock--out{% else %} tw-stock--low{% endif %}">
        {%- if is_pre -%}
          Pre-order{% if product.release_date %}, expected {{ product.release_date | date: '%-d %B %Y' }}{% endif %}
        {%- elsif product.available == false -%}
          Out of stock
        {%- else -%}
          Only {{ v.inventory_quantity }} left
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</article>
