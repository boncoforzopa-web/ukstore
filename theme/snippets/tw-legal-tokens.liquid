{%- comment -%}
  Fills the company placeholders in policy pages from Theme settings › Company details.
  A detail that has not been entered yet is shown as a clearly marked gap, never invented.
{%- endcomment -%}
{%- liquid
  assign m1 = '<mark class="tw-missing">['
  assign m2 = ' to be added]</mark>'
  if settings.legal_name != blank
    assign v_company = settings.legal_name | escape
  else
    assign v_company = settings.brand_name | escape
  endif
  if settings.business_address != blank
    assign v_address = settings.business_address | escape | newline_to_br
  else
    assign v_address = m1 | append: 'business address' | append: m2
  endif
  if settings.contact_email != blank
    assign v_email = '<a href="mailto:' | append: settings.contact_email | append: '">' | append: settings.contact_email | append: '</a>'
  else
    assign v_email = m1 | append: 'contact email' | append: m2
  endif
  if settings.returns_address != blank
    assign v_returns = settings.returns_address | escape | newline_to_br
  else
    assign v_returns = v_address
  endif
  assign out = content
  assign out = out | replace: '[[COMPANY]]', v_company
  assign out = out | replace: '[[ADDRESS]]', v_address
  assign out = out | replace: '[[EMAIL]]', v_email
  assign out = out | replace: '[[RETURNS_ADDRESS]]', v_returns
  assign out = out | replace: '[[RETURN_WINDOW]]', '14 days'
  assign out = out | replace: '[[REFUND_TIMING]]', 'within 14 days of receiving the goods back or proof that you have sent them'
  assign out = out | replace: '[[SHOP]]', settings.brand_name
  assign out = out | replace: '[[DOMAIN]]', shop.domain
  echo out
-%}
