{%- comment -%}
  Card language helper.
  Params:
    product  – product object (required)
    part     – 'title' (display title without language suffix),
               'flag'  (round flag icon, nothing if language unknown),
               'line'  (flag + "Sprache: … (… Karten)", nothing if unknown)
    size     – flag size in px (default 18)
  Detection order: title suffix ([ENG], [EN], (EN), [DE], (DE), [JP] …),
  then metafield custom.language, then tags (Englisch / Deutsch / Japanisch).
  The real product title is never changed – only what is displayed.
{%- endcomment -%}
{%- liquid
  assign t = product.title | strip
  assign code = ''
  assign cut = 0
  assign sfx = '[ENG]|en,[EN]|en,(ENG)|en,(EN)|en,[DE]|de,[GER]|de,(DE)|de,[JP]|jp,[JAP]|jp,[JPN]|jp,(JP)|jp' | split: ','
  for pair in sfx
    assign kv = pair | split: '|'
    assign k = kv[0]
    assign n = k.size
    assign neg = 0 | minus: n
    assign tail = t | slice: neg, n
    if tail == k
      assign code = kv[1]
      assign cut = n
      break
    endif
  endfor

  if code == ''
    assign mf = product.metafields.custom.language.value | append: '' | downcase | strip
    case mf
      when 'englisch', 'english', 'en', 'eng'
        assign code = 'en'
      when 'deutsch', 'german', 'de', 'ger'
        assign code = 'de'
      when 'japanisch', 'japanese', 'jp', 'ja', 'jap'
        assign code = 'jp'
    endcase
  endif

  if code == ''
    for tag in product.tags
      assign tl = tag | downcase | strip
      case tl
        when 'englisch', 'english', 'sprache: englisch', 'lang:en', 'language:en'
          assign code = 'en'
          break
        when 'deutsch', 'german', 'sprache: deutsch', 'lang:de', 'language:de'
          assign code = 'de'
          break
        when 'japanisch', 'japanese', 'sprache: japanisch', 'lang:jp', 'language:jp'
          assign code = 'jp'
          break
      endcase
    endfor
  endif

  case code
    when 'en'
      assign lname = 'Englisch'
      assign lcards = 'englische Karten'
    when 'de'
      assign lname = 'Deutsch'
      assign lcards = 'deutsche Karten'
    when 'jp'
      assign lname = 'Japanisch'
      assign lcards = 'japanische Karten'
  endcase
  assign fsize = size | default: 18
-%}
{%- case part -%}
  {%- when 'title' -%}
    {%- if cut > 0 -%}
      {%- assign keep = t.size | minus: cut -%}
      {{- t | slice: 0, keep | strip | escape -}}
    {%- else -%}
      {{- t | escape -}}
    {%- endif -%}
  {%- when 'flag' -%}
    {%- if code != '' -%}
      <span class="tw-flag" style="--flag: {{ fsize }}px" role="img" aria-label="Sprache: {{ lname }}" title="Sprache: {{ lname }}">{%- case code -%}{%- when 'en' -%}{% render 'tw-flag-en', size: fsize %}{%- when 'de' -%}{% render 'tw-flag-de', size: fsize %}{%- when 'jp' -%}{% render 'tw-flag-jp', size: fsize %}{%- endcase -%}</span>
    {%- endif -%}
  {%- when 'line' -%}
    {%- if code != '' -%}
      <p class="tw-langline"><span class="tw-flag" style="--flag: {{ fsize }}px" aria-hidden="true">{%- case code -%}{%- when 'en' -%}{% render 'tw-flag-en', size: fsize %}{%- when 'de' -%}{% render 'tw-flag-de', size: fsize %}{%- when 'jp' -%}{% render 'tw-flag-jp', size: fsize %}{%- endcase -%}</span><span>Sprache: {{ lname }} ({{ lcards }})</span></p>
    {%- endif -%}
{%- endcase -%}
