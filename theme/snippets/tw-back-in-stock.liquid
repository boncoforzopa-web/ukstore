{%- comment -%} Out of stock: the customer leaves an email and is told once when stock is back (needs order storage to be set up). {%- endcomment -%}
{%- if shop.forms_ready -%}
<form class="tw-bis" data-back-in-stock novalidate>
  <p class="tw-bis__text"><b>Email me when it is back.</b> One message when “{{ product.title }}” is in stock again, and nothing else.</p>
  <input type="hidden" name="variant_id" value="{{ variant.id }}">
  <div class="tw-bis__row">
    <input type="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@example.co.uk" aria-label="Email address">
    <button type="submit" class="tw-btn tw-btn--gold"><span>Notify me</span></button>
  </div>
  <p class="tw-bis__msg" role="status" aria-live="polite" hidden></p>
</form>
{%- endif -%}
