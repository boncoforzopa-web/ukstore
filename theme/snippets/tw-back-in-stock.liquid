{%- comment -%} Sold out: let the customer leave an e-mail and get notified once stock is back (admin sets stock > 0). {%- endcomment -%}
<form class="tw-bis tw-glass" data-back-in-stock novalidate>
  <p class="tw-kicker">{% render 'tw-icon', name: 'mail', size: 14 %} Wieder-da-Alarm</p>
  <p class="tw-bis__text">Trag deine E-Mail ein – wir melden uns <b>einmalig</b>, sobald „{% render 'tw-lang', product: product, part: 'title' %}“ wieder verfügbar ist.</p>
  <input type="hidden" name="variant_id" value="{{ variant.id }}">
  <div class="tw-bis__row">
    <input type="email" name="email" required autocomplete="email" inputmode="email" placeholder="deine@email.de" aria-label="E-Mail-Adresse">
    <button type="submit" class="tw-btn tw-btn--gold"><span>Benachrichtigen</span></button>
  </div>
  <p class="tw-small tw-muted">Kein Newsletter, keine Weitergabe – nur diese eine Nachricht.</p>
  <p class="tw-bis__msg" role="status" aria-live="polite" hidden></p>
</form>
