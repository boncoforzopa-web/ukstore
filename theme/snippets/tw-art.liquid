{%- comment -%}
  Original placeholder product art (no third-party IP).
  Params: type (booster|etb|tin|pack|bundle), hue (0-360), label, sub, class, uid (unique per render – gradients in hidden elements otherwise break)
{%- endcomment -%}
{%- liquid
  assign t = type | default: 'booster'
  assign h = hue | default: 265
  assign lbl = label | default: 'SEALED'
  assign sb = sub | default: 'TAWA GOLD'
  assign gid = 'tw' | append: t | append: h | append: '-' | append: uid
-%}
<svg class="tw-art {{ class }}" viewBox="0 0 400 400" role="img" aria-label="{{ lbl | escape }} – Platzhalterbild" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="{{ gid }}-gold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#FFE45C"/><stop offset=".5" stop-color="#FFD60A"/><stop offset="1" stop-color="#F2A900"/>
    </linearGradient>
    <linearGradient id="{{ gid }}-a" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="hsl({{ h }} 55% 30%)"/><stop offset="1" stop-color="hsl({{ h }} 60% 14%)"/>
    </linearGradient>
    <linearGradient id="{{ gid }}-b" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="hsl({{ h }} 50% 20%)"/><stop offset="1" stop-color="hsl({{ h }} 55% 9%)"/>
    </linearGradient>
    <linearGradient id="{{ gid }}-c" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="hsl({{ h }} 55% 44%)"/><stop offset="1" stop-color="hsl({{ h }} 55% 26%)"/>
    </linearGradient>
    <linearGradient id="{{ gid }}-shine" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#fff" stop-opacity="0"/><stop offset=".5" stop-color="#fff" stop-opacity=".22"/><stop offset="1" stop-color="#fff" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="{{ gid }}-glow" cx=".5" cy=".55" r=".5">
      <stop offset="0" stop-color="hsl({{ h }} 80% 60%)" stop-opacity=".45"/><stop offset="1" stop-color="hsl({{ h }} 80% 60%)" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <ellipse cx="200" cy="350" rx="150" ry="22" fill="#000" opacity=".35"/>
  <circle cx="200" cy="200" r="190" fill="url(#{{ gid }}-glow)"/>
  {%- case t -%}
    {%- when 'etb' -%}
      <polygon points="200,40 312.6,105 200,170 87.4,105" fill="url(#{{ gid }}-c)"/>
      <g transform="matrix(0.866 0.5 -0.866 0.5 200 40)">
        <path d="M65 30 L72 58 L100 65 L72 72 L65 100 L58 72 L30 65 L58 58Z" fill="url(#{{ gid }}-gold)" opacity=".9"/>
      </g>
      <polygon points="87.4,105 200,170 200,320 87.4,255" fill="url(#{{ gid }}-a)"/>
      <polygon points="200,170 312.6,105 312.6,255 200,320" fill="url(#{{ gid }}-b)"/>
      <g transform="matrix(0.866 0.5 0 1 87.4 105)">
        <rect x="0" y="38" width="130" height="2" fill="url(#{{ gid }}-gold)"/>
        <rect x="14" y="58" width="102" height="66" rx="6" fill="none" stroke="url(#{{ gid }}-gold)" stroke-width="1.5"/>
        <path d="M65 66 L70 86 L90 91 L70 96 L65 116 L60 96 L40 91 L60 86Z" fill="url(#{{ gid }}-gold)"/>
        <text x="65" y="138" text-anchor="middle" font-family="TW Display, sans-serif" font-size="9.5" font-weight="700" letter-spacing="1.4" fill="#FFE45C">{{ lbl | upcase | truncate: 22, '' }}</text>
        <rect x="-10" y="0" width="40" height="150" fill="url(#{{ gid }}-shine)" class="tw-art__shine"/>
      </g>
      <g transform="matrix(0.866 -0.5 0 1 200 170)">
        <rect x="0" y="38" width="130" height="2" fill="url(#{{ gid }}-gold)" opacity=".7"/>
        <text x="65" y="100" text-anchor="middle" font-family="TW Display, sans-serif" font-size="11" font-weight="700" letter-spacing="2" fill="#FFD60A" opacity=".85">{{ sb | upcase | truncate: 18, '' }}</text>
      </g>
    {%- when 'tin' -%}
      <path d="M90 120 V290 A110 34 0 0 0 310 290 V120Z" fill="url(#{{ gid }}-a)"/>
      <path d="M200 120 h110 V290 A110 34 0 0 1 200 324Z" fill="url(#{{ gid }}-b)" opacity=".7"/>
      <ellipse cx="200" cy="120" rx="110" ry="34" fill="url(#{{ gid }}-c)"/>
      <ellipse cx="200" cy="120" rx="110" ry="34" fill="none" stroke="url(#{{ gid }}-gold)" stroke-width="3"/>
      <ellipse cx="200" cy="118" rx="70" ry="20" fill="none" stroke="url(#{{ gid }}-gold)" stroke-width="1.2" opacity=".7"/>
      <path d="M90 150 A110 34 0 0 0 310 150 V158 A110 34 0 0 1 90 158Z" fill="url(#{{ gid }}-gold)"/>
      <path d="M200 175 L208 205 L238 213 L208 221 L200 251 L192 221 L162 213 L192 205Z" fill="url(#{{ gid }}-gold)"/>
      <text x="200" y="282" text-anchor="middle" font-family="TW Display, sans-serif" font-size="15" font-weight="700" letter-spacing="2.5" fill="#FFE45C">{{ lbl | upcase | truncate: 18, '' }}</text>
      <rect x="110" y="130" width="34" height="180" fill="url(#{{ gid }}-shine)" class="tw-art__shine"/>
    {%- when 'pack' -%}
      <g transform="rotate(-7 200 200)">
        <path d="M128 52 l9 -8 9 8 9 -8 9 8 9 -8 9 8 9 -8 9 8 9 -8 9 8 9 -8 9 8 9 -8 9 8 V348 l-9 8 -9 -8 -9 8 -9 -8 -9 8 -9 -8 -9 8 -9 -8 -9 8 -9 -8 -9 8 -9 -8 -9 8 -9 -8Z" fill="url(#{{ gid }}-a)"/>
        <rect x="128" y="66" width="144" height="6" fill="url(#{{ gid }}-gold)"/>
        <rect x="128" y="328" width="144" height="6" fill="url(#{{ gid }}-gold)"/>
        <path d="M200 130 L212 178 L260 190 L212 202 L200 250 L188 202 L140 190 L188 178Z" fill="url(#{{ gid }}-gold)"/>
        <circle cx="200" cy="190" r="74" fill="none" stroke="url(#{{ gid }}-gold)" stroke-width="1.2" opacity=".6"/>
        <text x="200" y="300" text-anchor="middle" font-family="TW Display, sans-serif" font-size="14" font-weight="700" letter-spacing="2" fill="#FFE45C">{{ lbl | upcase | truncate: 16, '' }}</text>
        <rect x="140" y="50" width="44" height="300" fill="url(#{{ gid }}-shine)" class="tw-art__shine"/>
      </g>
    {%- else -%}
      <polygon points="174,55 321.2,140 225.9,195 78.7,110" fill="url(#{{ gid }}-c)"/>
      <g transform="matrix(0.866 0.5 -0.866 0.5 174 55)">
        <rect x="10" y="10" width="150" height="90" rx="6" fill="none" stroke="url(#{{ gid }}-gold)" stroke-width="1.4" opacity=".75"/>
        <text x="85" y="62" text-anchor="middle" font-family="TW Display, sans-serif" font-size="13" font-weight="700" letter-spacing="3" fill="#FFE45C">{{ sb | upcase | truncate: 18, '' }}</text>
      </g>
      <polygon points="78.7,110 225.9,195 225.9,325 78.7,240" fill="url(#{{ gid }}-a)"/>
      <polygon points="225.9,195 321.2,140 321.2,270 225.9,325" fill="url(#{{ gid }}-b)"/>
      <g transform="matrix(0.866 0.5 0 1 78.7 110)">
        <rect x="0" y="0" width="170" height="4" fill="url(#{{ gid }}-gold)"/>
        <path d="M40 30 L47 56 L73 63 L47 70 L40 96 L33 70 L7 63 L33 56Z" fill="url(#{{ gid }}-gold)"/>
        <text x="86" y="58" font-family="TW Display, sans-serif" font-size="15" font-weight="800" letter-spacing="1" fill="#FFE45C">{{ lbl | upcase | truncate: 14, '' }}</text>
        <text x="86" y="76" font-family="TW Sans, sans-serif" font-size="8" font-weight="700" letter-spacing="2.4" fill="#FFD60A" opacity=".8">FACTORY SEALED</text>
        <rect x="0" y="112" width="170" height="2" fill="url(#{{ gid }}-gold)" opacity=".6"/>
        <rect x="-10" y="0" width="46" height="130" fill="url(#{{ gid }}-shine)" class="tw-art__shine"/>
      </g>
      <g transform="matrix(0.866 -0.5 0 1 225.9 195)">
        <rect x="0" y="0" width="110" height="4" fill="url(#{{ gid }}-gold)" opacity=".8"/>
        <path d="M55 42 L60 60 L78 65 L60 70 L55 88 L50 70 L32 65 L50 60Z" fill="url(#{{ gid }}-gold)" opacity=".8"/>
      </g>
  {%- endcase -%}
</svg>
