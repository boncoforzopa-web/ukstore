{%- comment -%}
  Original flat illustrations used wherever there is no photograph yet (category tiles, mega menu, empty states).
  Usage: {% render 'tw-art', type: 'tree' %}  ·  types: tree, bauble, wreath, lights, nutcracker, seasons, star, gift, tag
  Replace with photography by giving a category an "image" in data/collections.json.
{%- endcomment -%}
{%- assign light = false -%}
{%- if type == 'nutcracker' or type == 'seasons' or type == 'gift' or type == 'tag' -%}{%- assign light = true -%}{%- endif -%}
<svg class="tw-art tw-art--{{ type }}{% if light %} tw-art--light{% endif %}" viewBox="0 0 300 360" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <rect width="300" height="360" fill="{% if light %}#EDE4D2{% else %}#17362B{% endif %}"/>
  {%- case type -%}
  {%- when 'bauble' -%}
    <path d="M90 0v120M150 0v70M214 0v150" stroke="#D9C08A" stroke-width="1.5"/>
    <rect x="83" y="118" width="14" height="10" rx="2" fill="#D9C08A"/><circle cx="90" cy="172" r="46" fill="#9B1C31"/>
    <path d="M46 160q44 18 88 0M49 190q41 16 82 0" stroke="#D9C08A" stroke-width="2.5" fill="none"/>
    <rect x="143" y="68" width="14" height="10" rx="2" fill="#D9C08A"/><circle cx="150" cy="112" r="36" fill="#F7F2E8"/>
    <path d="M115 104q35 14 70 0" stroke="#B8975A" stroke-width="2" fill="none"/><circle cx="132" cy="124" r="2.500" fill="#B8975A"/><circle cx="150" cy="128" r="2.500" fill="#B8975A"/><circle cx="168" cy="124" r="2.500" fill="#B8975A"/>
    <rect x="207" y="148" width="14" height="10" rx="2" fill="#D9C08A"/><circle cx="214" cy="206" r="52" fill="#B8975A"/>
    <path d="M214 154v104M178 168q-22 38 0 76M250 168q22 38 0 76" stroke="#F7F2E8" stroke-opacity=".55" stroke-width="1.5" fill="none"/>
  {%- when 'wreath' -%}
    <rect x="52" y="40" width="196" height="330" fill="none" stroke="#2C5A45" stroke-width="2"/><rect x="74" y="62" width="152" height="330" fill="none" stroke="#2C5A45" stroke-width="2"/>
    <path d="M150 40v70" stroke="#9B1C31" stroke-width="5"/>
    <circle cx="150" cy="190" r="78" fill="none" stroke="#2F6B50" stroke-width="36"/>
    <circle cx="150" cy="190" r="86" fill="none" stroke="#4F8A6B" stroke-width="16" stroke-dasharray="5 15" stroke-linecap="round"/>
    <circle cx="150" cy="190" r="70" fill="none" stroke="#3F7A5C" stroke-width="14" stroke-dasharray="4 13" stroke-dashoffset="8" stroke-linecap="round"/>
    <g fill="#9B1C31"><circle cx="92" cy="140" r="5"/><circle cx="100" cy="132" r="5"/><circle cx="214" cy="150" r="5"/><circle cx="222" cy="160" r="5"/><circle cx="84" cy="226" r="5"/><circle cx="212" cy="236" r="5"/><circle cx="204" cy="244" r="5"/><circle cx="150" cy="112" r="5"/></g>
    <path d="M150 262l-34-18v40ZM150 262l34-18v40Z" fill="#9B1C31"/><path d="M150 262l-16 44 16-10 16 10Z" fill="#7F1527"/><circle cx="150" cy="262" r="8" fill="#7F1527"/>
  {%- when 'lights' -%}
    <g fill="none" stroke="#D9C08A" stroke-width="1.500"><path d="M0 80Q150 180 300 80"/><path d="M0 170Q150 270 300 170"/><path d="M0 260Q150 360 300 260"/></g>
    {%- assign xs = '30,75,120,165,210,255' | split: ',' -%}{%- assign ys = '98,117.500,128,129.500,122,105.500' | split: ',' -%}{%- assign cols = '#F3DFA6,#F7F2E8,#C8475B' | split: ',' -%}
    {%- for row in (0..2) -%}{%- for x in xs -%}
      {%- assign y = ys[forloop.index0] | plus: 0 -%}{%- assign yy = row | times: 90 | plus: y -%}{%- assign ci = forloop.index0 | plus: row | modulo: 3 -%}
      <circle cx="{{ x }}" cy="{{ yy | plus: 9 }}" r="16" fill="{{ cols[ci] }}" opacity=".16"/><rect x="{{ x | minus: 3 }}" y="{{ yy | minus: 1 }}" width="6" height="5" fill="#B8975A"/><ellipse class="tw-twinkle" style="animation-delay: {{ forloop.index0 | plus: row | times: 0.37 }}s" cx="{{ x }}" cy="{{ yy | plus: 10 }}" rx="5.500" ry="7.500" fill="{{ cols[ci] }}"/>
    {%- endfor -%}{%- endfor -%}
  {%- when 'nutcracker' -%}
    <rect x="104" y="318" width="92" height="12" fill="#B8975A"/>
    <rect x="124" y="244" width="22" height="62" fill="#F7F2E8"/><rect x="154" y="244" width="22" height="62" fill="#F7F2E8"/><rect x="120" y="302" width="28" height="16" fill="#17362B"/><rect x="152" y="302" width="28" height="16" fill="#17362B"/>
    <rect x="98" y="154" width="16" height="72" fill="#9B1C31"/><rect x="186" y="154" width="16" height="72" fill="#9B1C31"/><rect x="98" y="226" width="16" height="12" fill="#E7C7A5"/><rect x="186" y="226" width="16" height="12" fill="#E7C7A5"/>
    <rect x="116" y="150" width="68" height="94" fill="#9B1C31"/><rect x="116" y="226" width="68" height="10" fill="#17362B"/><rect x="144" y="224" width="12" height="14" fill="#D9C08A"/>
    <path d="M150 150v76" stroke="#D9C08A" stroke-width="2"/><g fill="#D9C08A"><circle cx="150" cy="168" r="3.500"/><circle cx="150" cy="186" r="3.500"/><circle cx="150" cy="204" r="3.500"/><rect x="92" y="146" width="28" height="10" rx="2"/><rect x="180" y="146" width="28" height="10" rx="2"/></g>
    <rect x="128" y="104" width="44" height="46" fill="#E7C7A5"/><path d="M128 136h44v14l-22 26-22-26Z" fill="#F7F2E8"/><path d="M134 132q16 10 32 0" stroke="#17362B" stroke-width="4" fill="none"/><circle cx="141" cy="120" r="2.500" fill="#17362B"/><circle cx="159" cy="120" r="2.500" fill="#17362B"/>
    <rect x="124" y="52" width="52" height="54" fill="#17362B"/><rect x="124" y="92" width="52" height="10" fill="#D9C08A"/><path d="M150 52c0-14 6-22 16-26-2 10-6 18-16 26Z" fill="#9B1C31"/>
  {%- when 'seasons' -%}
    <path d="M150 168c0-18 6-28 18-32" stroke="#2F6B50" stroke-width="7" fill="none" stroke-linecap="round"/>
    <path d="M166 150c14-16 36-18 52-8-12 18-34 22-52 8Z" fill="#2F6B50"/>
    <ellipse cx="150" cy="236" rx="84" ry="64" fill="#B9692A"/><ellipse cx="112" cy="236" rx="42" ry="62" fill="#C7772E"/><ellipse cx="188" cy="236" rx="42" ry="62" fill="#C7772E"/><ellipse cx="150" cy="236" rx="30" ry="64" fill="#D48A42"/>
    <path d="M60 110c10-22 34-28 50-16-8 22-32 30-50 16Z" fill="#9B1C31"/><path d="M62 109l44-14" stroke="#EDE4D2" stroke-width="1.500"/>
    <path d="M226 96c4-16 20-22 32-16-4 16-18 24-32 16Z" fill="#B8975A"/>
  {%- when 'star' -%}
    <path d="M150 0v110" stroke="#D9C08A" stroke-width="1.500"/>
    <path d="M150 110l10.700 44.100 38.800-23.600-23.600 38.800L220 180l-44.100 10.700 23.600 38.800-38.800-23.600L150 250l-10.700-44.100-38.800 23.600 23.600-38.800L80 180l44.100-10.700-23.600-38.800 38.800 23.600Z" fill="#D9C08A"/>
    <circle cx="150" cy="180" r="12" fill="#17362B"/><circle cx="150" cy="180" r="5" fill="#D9C08A"/>
    <g fill="#F7F2E8"><path class="tw-twinkle" d="M62 84l3 9 9 3-9 3-3 9-3-9-9-3 9-3Z"/><path class="tw-twinkle" style="animation-delay:.900s" d="M238 268l3 9 9 3-9 3-3 9-3-9-9-3 9-3Z"/><path class="tw-twinkle" style="animation-delay:1.700s" d="M244 96l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z"/><path d="M70 262l2 6 6 2-6 2-2 6-2-6-6-2 6-2Z"/></g>
  {%- when 'gift' -%}
    <rect x="176" y="204" width="84" height="106" fill="#17362B"/><rect x="212" y="204" width="12" height="106" fill="#F7F2E8"/><path d="M218 204c-10-18-26-20-28-8 2 10 16 10 28 8Zm0 0c10-18 26-20 28-8-2 10-16 10-28 8Z" fill="#F7F2E8"/>
    <rect x="60" y="196" width="130" height="114" fill="#9B1C31"/><rect x="50" y="170" width="150" height="30" fill="#7F1527"/><rect x="114" y="170" width="22" height="140" fill="#D9C08A"/>
    <path d="M125 170c-16-34-46-36-50-18 4 18 30 20 50 18Zm0 0c16-34 46-36 50-18-4 18-30 20-50 18Z" fill="#D9C08A"/><circle cx="125" cy="168" r="8" fill="#B8975A"/>
    <rect x="40" y="310" width="232" height="3" fill="#B8975A" opacity=".5"/>
  {%- when 'tag' -%}
    <path d="M168 0c-30 40-40 70-22 112" stroke="#B8975A" stroke-width="1.500" fill="none"/>
    <g transform="rotate(-10 150 200)"><path d="M112 110h76l22 26v150H90V136Z" fill="#9B1C31"/><circle cx="150" cy="136" r="8" fill="#EDE4D2"/><path d="M104 262h92" stroke="#F7F2E8" stroke-opacity=".5" stroke-width="1.500"/>
    <text x="150" y="238" text-anchor="middle" font-family="'Caslon Display', Georgia, serif" font-size="78" fill="#F7F2E8">%</text></g>
  {%- else -%}
    <circle cx="150" cy="190" r="120" fill="#D9C08A" opacity=".08"/>
    <rect x="141" y="284" width="18" height="30" fill="#5B3F25"/>
    <path d="M150 62l58 88h-28l46 66h-32l52 70H54l52-70H74l46-66H92Z" fill="#2F6B50"/><path d="M150 62l58 88h-28l46 66h-32l52 70h-96Z" fill="#275C44"/>
    <g fill="none" stroke="#D9C08A" stroke-width="1.500"><path d="M112 140q38 20 78 2"/><path d="M96 206q54 26 112 2"/><path d="M76 270q74 30 150 2"/></g>
    <g fill="#F3DFA6"><circle class="tw-twinkle" cx="128" cy="148" r="3.500"/><circle cx="168" cy="149" r="3.500"/><circle cx="118" cy="216" r="3.500"/><circle class="tw-twinkle" style="animation-delay:.800s" cx="152" cy="222" r="3.500"/><circle cx="186" cy="216" r="3.500"/><circle cx="104" cy="282" r="3.500"/><circle cx="150" cy="290" r="3.500"/><circle class="tw-twinkle" style="animation-delay:1.500s" cx="196" cy="283" r="3.500"/></g>
    <g fill="#C8475B"><circle cx="140" cy="118" r="5"/><circle cx="170" cy="184" r="5"/><circle cx="110" cy="250" r="5"/><circle cx="200" cy="254" r="5"/></g><g fill="#F7F2E8"><circle cx="128" cy="186" r="5"/><circle cx="160" cy="258" r="5"/></g>
    <path d="M150 30l6.500 14.500 15.500 1.500-11.500 10.500 3.500 15.500-14-8-14 8 3.500-15.500L138 46l15.500-1.500Z" fill="#D9C08A"/>
    <path d="M0 314q150-22 300 0v46H0Z" fill="#F7F2E8" opacity=".1"/>
  {%- endcase -%}
</svg>
