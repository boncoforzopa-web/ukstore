{%- comment -%}
  Free gift with purchase (lib/gift.js). Params: g = cart.gift, mode = 'bar' | 'line' | 'coline'
  bar    → progress note "Noch X € bis zu deinem Gratis-Geschenk" (only while not unlocked)
  line   → €0 gift line inside the cart drawer / cart page (only when unlocked)
  coline → €0 gift line inside the checkout summary (only when unlocked)
{%- endcomment -%}
{%- if g and g.enabled -%}
  {%- if mode == 'bar' -%}
    {%- unless g.unlocked -%}
      <div class="tw-ship tw-gift-bar">
        <p class="tw-small">🎁 Noch <strong>{{ g.remaining | money_without_currency | strip | append: ' €' }}</strong> bis zu deinem <strong>Gratis-Geschenk</strong>: Scorching Summit PRO-Binder</p>
        <div class="tw-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ g.progress }}" aria-label="Fortschritt Gratis-Geschenk"><span style="width: {{ g.progress }}%"></span></div>
      </div>
    {%- else -%}
      <div class="tw-ship tw-gift-bar is-on"><p class="tw-small">🎁 <strong>Gratis-Geschenk freigeschaltet!</strong> Der Scorching Summit PRO-Binder liegt deiner Bestellung bei.</p></div>
    {%- endunless -%}
  {%- elsif g.unlocked -%}
    {%- if mode == 'coline' -%}
      <li class="tw-co__item tw-co__item--gift">
        <span class="tw-co__thumb"><img src="{{ g.image }}" alt="" width="64" height="64" loading="lazy"><b class="tw-co__qty">1</b></span>
        <span class="tw-co__item-body"><span class="tw-co__item-title">{{ g.title }}</span></span>
        <strong class="tw-co__item-price">0,00 €</strong>
      </li>
    {%- else -%}
      <li class="tw-line tw-line--gift{% if page_line %} tw-glass{% endif %}">
        <span class="tw-line__media"><img src="{{ g.image_large }}" alt="{{ g.title | escape }}" width="240" height="240" loading="lazy"></span>
        <div class="tw-line__info">
          <p class="tw-line__title">{{ g.title }}</p>
          <div class="tw-line__row">
            <span class="tw-small tw-muted">Menge: 1 · nicht einzeln erhältlich</span>
            <div class="tw-line__price"><strong>0,00 €</strong></div>
          </div>
        </div>
      </li>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
<style>.tw-gift-bar.is-on{background:rgba(255,214,10,.14);border-radius:12px}.tw-line--gift .tw-line__media img,.tw-co__item--gift img{width:100%;height:100%;object-fit:contain;background:#fff;border-radius:10px}.tw-line--gift .tw-chip,.tw-co__item--gift .tw-chip{align-self:flex-start;justify-self:start;width:fit-content;max-width:100%}</style>
