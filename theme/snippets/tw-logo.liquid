<script>
(function () {
  var logo = document.currentScript.previousElementSibling;
  if (!logo || !logo.classList || !logo.classList.contains('tw-logo')) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var mint = logo.querySelector('.tw-logo__mint'), timers = {};
  function play(cls, ms) {
    logo.classList.remove(cls); void logo.offsetWidth; logo.classList.add(cls);
    clearTimeout(timers[cls]); timers[cls] = setTimeout(function () { logo.classList.remove(cls); }, ms);
  }
  /* the peppermint always turns; this changes how fast */
  function spin(rate) { try { mint.getAnimations().forEach(function (a) { a.playbackRate = rate; }); } catch (e) {} }
  if (logo.closest('.tw-header')) {
    /* The mint rolls in and the letters pop up once per visit, not on every page */
    var seen = true;
    try { seen = sessionStorage.getItem('tw-logo-in'); sessionStorage.setItem('tw-logo-in', '1'); } catch (e) {}
    if (!seen) play('tw-logo--intro', 2300);
    /* Something went into the basket: the mint jumps and the letters do a wave */
    document.addEventListener('tw:cart:added', function () { play('is-pop', 1200); play('is-wave', 1100); spin(9); setTimeout(function () { spin(logo.matches(':hover') ? 6 : 1); }, 1200); });
  }
  logo.addEventListener('pointerenter', function (e) { if (e.pointerType === 'touch') return; spin(6); if (!logo.classList.contains('tw-logo--intro')) play('is-wave', 1100); });
  logo.addEventListener('pointerleave', function () { spin(1); });
  logo.addEventListener('focus', function () { if (logo.matches(':focus-visible')) play('is-wave', 1100); });
})();
</script>
