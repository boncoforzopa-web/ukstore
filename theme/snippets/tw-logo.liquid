{%- comment -%} Brand lockup: lantern emblem (a larch inside the shop's arch) + wordmark + optional tagline. {%- endcomment -%}
<a href="{{ routes.root_url }}" class="tw-logo" aria-label="{{ settings.brand_name | escape }} home">
  {%- if settings.logo != blank -%}
    {{ settings.logo | image_url: width: 520 | image_tag: class: 'tw-logo__img', alt: settings.brand_name, widths: '260, 520', sizes: '170px', style: 'width: var(--tw-logo-w); height: auto;', loading: 'eager' }}
  {%- else -%}
    {%- unless settings.logo_emblem == false -%}
      <svg class="tw-logo__mark" viewBox="0 0 40 54" aria-hidden="true" focusable="false">
        <circle cx="20" cy="5" r="3.200" fill="none" stroke="currentColor" stroke-width="1.600"/>
        <path d="M14.500 12.500q5.500-6 11 0Z" fill="currentColor"/>
        <path d="M5 48V27a15 15 0 0 1 30 0v21Z" fill="currentColor"/>
        <path d="M8 48V27a12 12 0 0 1 24 0v21" fill="none" stroke="var(--gold)" stroke-width=".800" opacity=".7"/>
        <rect x="2.500" y="48" width="35" height="3.600" rx="1.200" fill="currentColor"/>
        <path d="M20 22.500l5.200 6.700h-2.700l4.700 6.300h-3l5 6.700H10.800l5-6.700h-3l4.700-6.300h-2.700Z" fill="var(--ivory)"/>
        <rect x="18.900" y="42.200" width="2.200" height="3.200" fill="var(--gold)"/>
        <path class="tw-logo__star" d="M20 14.600l1.300 3.300 3.300 1.300-3.300 1.300-1.300 3.300-1.300-3.300-3.300-1.300 3.300-1.300Z" fill="var(--gold-light)"/>
      </svg>
    {%- endunless -%}
    <span class="tw-logo__text">
      <span class="tw-logo__word">{{ settings.wordmark_first }}{% if settings.wordmark_second != blank %} <i>&amp;</i> {{ settings.wordmark_second }}{% endif %}</span>
      {%- if settings.logo_tagline != blank -%}<span class="tw-logo__tag">{{ settings.logo_tagline }}</span>{%- endif -%}
    </span>
  {%- endif -%}
</a>
