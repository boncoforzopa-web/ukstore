{%- if form.errors -%}<div class="tw-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
<div class="tw-field-row">
  <div class="tw-field"><label for="AddressFirst-{{ id }}">Vorname</label><input id="AddressFirst-{{ id }}" name="address[first_name]" type="text" value="{{ form.first_name }}" autocomplete="given-name"></div>
  <div class="tw-field"><label for="AddressLast-{{ id }}">Nachname</label><input id="AddressLast-{{ id }}" name="address[last_name]" type="text" value="{{ form.last_name }}" autocomplete="family-name"></div>
</div>
<div class="tw-field"><label for="AddressCompany-{{ id }}">Firma (optional)</label><input id="AddressCompany-{{ id }}" name="address[company]" type="text" value="{{ form.company }}" autocomplete="organization"></div>
<div class="tw-field"><label for="AddressAddress1-{{ id }}">Straße und Hausnummer</label><input id="AddressAddress1-{{ id }}" name="address[address1]" type="text" value="{{ form.address1 }}" autocomplete="address-line1"></div>
<div class="tw-field"><label for="AddressAddress2-{{ id }}">Adresszusatz</label><input id="AddressAddress2-{{ id }}" name="address[address2]" type="text" value="{{ form.address2 }}" autocomplete="address-line2"></div>
<div class="tw-field-row">
  <div class="tw-field"><label for="AddressZip-{{ id }}">PLZ</label><input id="AddressZip-{{ id }}" name="address[zip]" type="text" value="{{ form.zip }}" autocomplete="postal-code"></div>
  <div class="tw-field"><label for="AddressCity-{{ id }}">Ort</label><input id="AddressCity-{{ id }}" name="address[city]" type="text" value="{{ form.city }}" autocomplete="address-level2"></div>
</div>
<div class="tw-field"><label for="AddressCountry-{{ id }}">Land</label><select id="AddressCountry-{{ id }}" name="address[country]" data-country-select="{{ id }}" data-default="{{ form.country | default: 'Germany' }}">{{ all_country_option_tags }}</select></div>
<div class="tw-field" id="AddressProvinceWrap-{{ id }}"><label for="AddressProvince-{{ id }}">Bundesland</label><select id="AddressProvince-{{ id }}" name="address[province]" data-default="{{ form.province }}"></select></div>
<div class="tw-field"><label for="AddressPhone-{{ id }}">Telefon</label><input id="AddressPhone-{{ id }}" name="address[phone]" type="tel" value="{{ form.phone }}" autocomplete="tel"></div>
<label class="tw-check"><input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox %} checked{% endif %}><span class="tw-check__box" aria-hidden="true">{% render 'tw-icon', name: 'check', size: 14 %}</span><span>Als Standardadresse festlegen</span></label>
