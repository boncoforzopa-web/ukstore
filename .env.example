# Stripe (Dashboard › Developers › API keys / Webhooks). Start with test keys (sk_test_… / pk_test_…).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional. Webhook URL: https://<your-domain>/api/stripe-webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
STRIPE_WEBHOOK_SECRET=

# Orders, stock, messages and newsletter storage (Vercel › Storage › Upstash Redis adds these)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-mail through resend.com (the sending domain must be verified there)
RESEND_API_KEY=
MAIL_FROM=Shop name <hello@your-domain.co.uk>
MAIL_TO=hello@your-domain.co.uk

# Signs the basket cookie and admin session (any long random string)
CART_SECRET=

# Order admin at /admin (choose a strong password)
ADMIN_PASSWORD=

# Optional
SHOP_DOMAIN=your-domain.co.uk
# Delivery charge in pence and the order value (pence) from which delivery is free (0 = no threshold)
SHIP_FEE_PENCE=
SHIP_FREE_FROM_PENCE=
MIN_ORDER_CENTS=0
# Google tag IDs (comma-separated, e.g. AW-…, G-…) and Ads purchase conversion labels (AW-…/label)
GOOGLE_TAG_IDS=
GOOGLE_ADS_PURCHASE_LABEL=
