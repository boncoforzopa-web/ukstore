# Stripe (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...     # used by the checkout page (Payment Element)
STRIPE_WEBHOOK_SECRET=whsec_...        # webhook URL: https://tawagold.store/api/stripe-webhook – events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded

# Stock + order storage (Vercel → Storage → Upstash Redis / KV, adds these automatically)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-mails (resend.com, domain tawagold.store verified)
RESEND_API_KEY=re_...
MAIL_FROM=TAWAGOLD <kontakt@tawagold.store>
MAIL_TO=kontakt@tawagold.store

# Cart cookie signing (any long random string)
CART_SECRET=

# Optional
SHOP_DOMAIN=tawagold.store
GOOGLE_TAG_IDS=AW-18563400376,MC-6HE5GH3QKM,MC-BJ8V6B473G
# comma-separated: one purchase label per Google Ads account
GOOGLE_ADS_PURCHASE_LABEL=AW-18563400376/OnjQCMjFuLQdELiF3JNF

# Order admin at /admin (choose a strong password)
ADMIN_PASSWORD=
